@page "/"
@namespace TheNextPick.Pages
@using TheNextPick.Models
@using TheNextPick.Engine
@using TheNextPick.Components
@inject GameStateService GameState
@inject IJSRuntime JS
@implements IDisposable

<div class="container py-4" style="max-width: 840px;">

    @if (GameState.FaseActual == FaseJuego.Creacion)
    {
        <div class="sports-card p-4 border border-secondary text-center">
            <div class="d-flex justify-content-center align-items-center gap-3 mb-2">
                <img src="https://a.espncdn.com/i/teamlogos/leagues/500/nba.png" style="height: 44px;" alt="NBA" />
                <h1 class="nba-title display-5 text-white mb-0">THE NEXT PICK</h1>
            </div>
            <p class="text-secondary small mb-4">Simulador de Carrera NBA 2026-2027</p>

            @if (tienePartidaGuardada)
            {
                <div class="d-grid mb-4">
                    <button class="btn btn-outline-success py-2 fw-bold" @onclick="CargarPartidaGuardada">
                        Continuar Carrera Guardada
                    </button>
                </div>
                <hr class="border-secondary my-3" />
            }

            <div class="row g-2 mb-3 text-start">
                <div class="col-8">
                    <label class="form-label text-secondary small fw-bold">NOMBRE DE LA PROMESA</label>
                    <input class="form-control bg-dark text-white border-secondary" placeholder="Ej: Marcus Vance" @bind="nombreInput" />
                </div>
                <div class="col-4">
                    <label class="form-label text-secondary small fw-bold">PAÍS</label>
                    <select class="form-select bg-dark text-white border-secondary" @bind="paisInput">
                        <option value="Colombia">🇨🇴 Colombia</option>
                        <option value="Estados Unidos">🇺🇸 Estados Unidos</option>
                        <option value="España">🇪🇸 España</option>
                        <option value="Argentina">🇦🇷 Argentina</option>
                        <option value="Francia">🇫🇷 Francia</option>
                        <option value="Canadá">🇨🇦 Canadá</option>
                        <option value="República Dominicana">🇩🇴 Rep. Dominicana</option>
                        <option value="México">🇲🇽 México</option>
                    </select>
                </div>
            </div>

            <div class="row g-2 mb-3 text-start">
                <div class="col-6">
                    <label class="form-label text-secondary small fw-bold">DORSAL (#)</label>
                    <input type="number" class="form-control bg-dark text-white border-secondary" min="0" max="99" @bind="dorsalInput" />
                </div>
                <div class="col-6">
                    <label class="form-label text-secondary small fw-bold">POSICIÓN</label>
                    <select class="form-select bg-dark text-white border-secondary" @bind="posicionInput">
                        @foreach (var pos in Enum.GetValues<Posicion>())
                        {
                            <option value="@pos">@pos</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mb-4 text-start">
                <label class="form-label text-secondary small fw-bold">RITMO DE LA SIMULACIÓN</label>
                <select class="form-select bg-dark text-white border-secondary" @bind="ritmoInput">
                    <option value="@RitmoSimulacion.Detallada">Temporada Rápida (4 decisiones + postemporada)</option>
                    <option value="@RitmoSimulacion.Expres">Modo Exprés (Cada 2 temporadas)</option>
                </select>
            </div>

            <div class="d-grid gap-2">
                <button class="btn btn-warning py-3 fw-bold text-dark" @onclick="IniciarRutaDraft">
                    Entrar al NBA Draft Combine
                </button>
                <button class="btn btn-outline-light py-2" @onclick="IniciarRutaAleatoria">
                    Sorteo Directo a Franquicia
                </button>
            </div>
        </div>
    }
    else if (GameState.FaseActual == FaseJuego.DraftCombine)
    {
        <DraftCombine />
    }
    else if (GameState.FaseActual == FaseJuego.EleccionEquipo)
    {
        <div class="sports-card p-4 text-center">
            <h2 class="nba-title display-4 text-warning mb-0">NOCHE DEL DRAFT</h2>
            <p class="text-secondary">Puntos de Combine: <strong class="text-white">@GameState.PuntosCombine</strong></p>

            <div class="p-3 my-3 rounded bg-dark border border-warning">
                <h4 class="nba-title text-white mb-0 fs-2">SELECCIÓN OFICIAL: PICK #@GameState.PickAsignado</h4>
            </div>

            <h6 class="text-secondary small fw-bold mt-4 mb-3">FRANQUICIAS DISPONIBLES:</h6>
            <div class="row g-2">
                @foreach (var equipo in GameState.EquiposDisponiblesDraft)
                {
                    <div class="col-12">
                        <button class="btn btn-choice w-100 p-3 d-flex align-items-center justify-content-between"
                                style="border-left: 5px solid @equipo.ColorPrimario;"
                                @onclick="() => ElegirEquipo(equipo.Nombre)">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@equipo.LogoUrl" style="height: 42px; width: 42px; object-fit: contain;" alt="@equipo.Nombre" />
                                <div class="text-start">
                                    <span class="fs-5 text-white d-block">@equipo.Nombre</span>
                                    <small class="text-secondary">Estrella 26-27: @equipo.EstrellaFranquicia (@equipo.MediaEstrella OVR)</small>
                                </div>
                            </div>
                            <span class="badge bg-secondary">Firmar</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    }
    else if (GameState.FaseActual == FaseJuego.TemporadaRegular)
    {
        var eq = EquipoNBA.ObtenerPorNombre(GameState.JugadorActivo?.EquipoActual ?? "");

        <!-- PERFIL DEL JUGADOR Y DÚO DINÁMICO -->
        <div class="sports-card p-3 mb-3" style="border-top: 3px solid @eq.ColorPrimario;">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 p-2 text-center text-dark fw-bold" style="background: #f59e0b; min-width: 55px;">
                        <div style="font-size: 0.65rem; line-height: 1;">OVR</div>
                        <div class="fs-4 lh-1">@GameState.JugadorActivo?.OVR</div>
                    </div>

                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="text-white mb-0 fw-bold">@GameState.JugadorActivo?.Nombre</h4>
                            <span class="badge bg-dark border border-secondary text-light small">@GameState.JugadorActivo?.Pais</span>
                        </div>
                        <span class="text-secondary small">#@GameState.JugadorActivo?.NumeroDorsal @GameState.JugadorActivo?.Posicion | @eq.Nombre</span>
                    </div>
                </div>

                <div class="text-end">
                    <img src="@eq.LogoUrl" style="height: 48px; width: 48px; object-fit: contain;" alt="Logo" />
                    <div class="small fw-bold text-success mt-1">$@((GameState.DineroDisponible / 1_000_000.0).ToString("0.0"))M</div>
                </div>
            </div>

            <!-- DÚO DINÁMICO 2026-2027 & NÉMESIS -->
            <div class="row g-2 mt-2">
                <div class="col-6">
                    <div class="p-2 rounded bg-black border border-secondary text-start small">
                        <span class="text-secondary" style="font-size: 0.7rem;">⭐ DÚO DINÁMICO (26-27)</span>
                        <div class="fw-bold text-white">@GameState.EstrellaCompanero</div>
                        <div class="text-muted" style="font-size: 0.65rem;">Química en cancha: <strong class="text-warning">@GameState.QuimicaEstrella%</strong></div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-2 rounded bg-black border border-secondary text-start small">
                        <span class="text-secondary" style="font-size: 0.7rem;">⚔️ RIVAL DEL DRAFT</span>
                        <div class="fw-bold text-danger">@GameState.NombreRivalDraft</div>
                        <div class="text-muted" style="font-size: 0.65rem;">@GameState.EquipoRivalDraft (@GameState.PpgRivalDraft PPG vs @GameState.JugadorActivo?.PromedioPuntos)</div>
                    </div>
                </div>
            </div>

            <!-- APARTADO DE ESTADÍSTICAS GLOBALES -->
            <div class="card bg-black border-secondary p-2 my-2 rounded">
                <div class="d-flex justify-content-between px-2 mb-1">
                    <span class="text-secondary small fw-bold text-uppercase">Estadísticas Globales de Carrera</span>
                    <span class="text-warning small fw-bold">Partidos: @GameState.JugadorActivo?.PartidosTotales</span>
                </div>
                <div class="row g-1 text-center small">
                    <div class="col-3 p-1 rounded bg-dark border border-secondary">
                        <div class="text-secondary" style="font-size: 0.7rem;">PPG</div>
                        <strong class="text-warning">@GameState.JugadorActivo?.PromedioPuntos</strong>
                    </div>
                    <div class="col-3 p-1 rounded bg-dark border border-secondary">
                        <div class="text-secondary" style="font-size: 0.7rem;">RPG</div>
                        <strong class="text-info">@GameState.JugadorActivo?.PromedioRebotes</strong>
                    </div>
                    <div class="col-3 p-1 rounded bg-dark border border-secondary">
                        <div class="text-secondary" style="font-size: 0.7rem;">APG</div>
                        <strong class="text-success">@GameState.JugadorActivo?.PromedioAsistencias</strong>
                    </div>
                    <div class="col-3 p-1 rounded bg-dark border border-secondary">
                        <div class="text-secondary" style="font-size: 0.7rem;">WIN %</div>
                        <strong class="text-light">@GameState.JugadorActivo?.PorcentajeVictorias%</strong>
                    </div>
                </div>
            </div>

            <!-- BARRAS DE ESTADO -->
            <div class="row g-2">
                <div class="col-3">
                    <div class="stat-bar-container text-center">
                        <small class="text-secondary fw-bold">ENERGÍA</small>
                        <div class="stat-bar-fill energy-glow mt-1" style="width: @GameState.Energia%;"></div>
                        <span class="small text-white fw-bold">@GameState.Energia%</span>
                    </div>
                </div>
                <div class="col-3">
                    <div class="stat-bar-container text-center">
                        <small class="text-secondary fw-bold">DT</small>
                        <div class="stat-bar-fill dt-glow mt-1" style="width: @GameState.ConfianzaDT%;"></div>
                        <span class="small text-white fw-bold">@GameState.ConfianzaDT%</span>
                    </div>
                </div>
                <div class="col-3">
                    <div class="stat-bar-container text-center">
                        <small class="text-secondary fw-bold">QUÍMICA</small>
                        <div class="stat-bar-fill quimica-glow mt-1" style="width: @GameState.Quimica%;"></div>
                        <span class="small text-white fw-bold">@GameState.Quimica%</span>
                    </div>
                </div>
                <div class="col-3">
                    <div class="stat-bar-container text-center">
                        <small class="text-secondary fw-bold">HYPE</small>
                        <div class="stat-bar-fill hype-glow mt-1" style="width: @GameState.Hype%;"></div>
                        <span class="small text-white fw-bold">@GameState.Hype%</span>
                    </div>
                </div>
            </div>

            <!-- BOTÓN DESPLEGABLE TIENDA DE ESTILO DE VIDA -->
            <div class="mt-3">
                <button class="btn btn-outline-warning btn-sm w-100 fw-bold" @onclick="() => mostrarTienda = !mostrarTienda">
                    💼 TIENDA DE ESTILO DE VIDA Y NEGOCIOS ($@((GameState.DineroDisponible / 1_000_000.0).ToString("0.0"))M DISPONIBLE)
                </button>
            </div>

            @if (mostrarTienda)
            {
                <div class="p-3 my-2 rounded bg-dark border border-warning text-start">
                    <h6 class="text-white fw-bold mb-2">Inversiones y Bienestar Personal</h6>
                    <div class="row g-2">
                        <div class="col-12 d-flex justify-content-between align-items-center p-2 rounded bg-black">
                            <div>
                                <strong class="text-light d-block">Chef Personal y Fisioterapeuta ($1.2M)</strong>
                                <small class="text-secondary">Reduce en 5 puntos el desgaste físico tras cada partido.</small>
                            </div>
                            <button class="btn btn-sm @(GameState.TieneChefPersonal ? "btn-secondary" : "btn-warning")" 
                                    disabled="@(GameState.TieneChefPersonal || GameState.DineroDisponible < 1_200_000)"
                                    @onclick="() => GameState.ComprarChefPersonal()">
                                @(GameState.TieneChefPersonal ? "Comprado" : "Contratar")
                            </button>
                        </div>
                        <div class="col-12 d-flex justify-content-between align-items-center p-2 rounded bg-black">
                            <div>
                                <strong class="text-light d-block">Línea de Zapatillas Signature ($2.0M)</strong>
                                <small class="text-secondary">Aumenta en 30% las ganancias de Hype.</small>
                            </div>
                            <button class="btn btn-sm @(GameState.TieneZapatillasExclusivas ? "btn-secondary" : "btn-warning")" 
                                    disabled="@(GameState.TieneZapatillasExclusivas || GameState.DineroDisponible < 2_000_000)"
                                    @onclick="() => GameState.ComprarZapatillasExclusivas()">
                                @(GameState.TieneZapatillasExclusivas ? "Comprado" : "Lanzar")
                            </button>
                        </div>
                        <div class="col-12 d-flex justify-content-between align-items-center p-2 rounded bg-black">
                            <div>
                                <strong class="text-light d-block">Inversión en Startup de Bebidas ($1.5M)</strong>
                                <small class="text-secondary">Genera +$800K extra al final de cada temporada.</small>
                            </div>
                            <button class="btn btn-sm @(GameState.TieneInversionStartup ? "btn-secondary" : "btn-warning")" 
                                    disabled="@(GameState.TieneInversionStartup || GameState.DineroDisponible < 1_500_000)"
                                    @onclick="() => GameState.ComprarInversionStartup()">
                                @(GameState.TieneInversionStartup ? "Comprado" : "Invertir")
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (GameState.PartidosJugados > 0)
        {
            <div class="alert @(GameState.UltimoFueVictoria ? "alert-success" : "alert-danger") py-2 px-3 small border-0 text-center mb-2">
                @(GameState.UltimoFueVictoria ? "Victoria" : "Derrota") | Actuación: <strong>@GameState.UltimosPuntos Pts, @GameState.UltimosRebotes Reb, @GameState.UltimasAsistencias Ast</strong>
            </div>
        }

        @if (!string.IsNullOrEmpty(GameState.UltimaNoticia))
        {
            <div class="alert alert-dark py-2 px-3 small border border-secondary text-center mb-2 text-info">
                <em>@GameState.UltimaNoticia</em>
            </div>
        }

        <DecisionCard />
    }
    else if (GameState.FaseActual == FaseJuego.AllStarTriples)
    {
        <ConcursoTriples OnFinalizado="(pts) => GameState.FinalizarAllStarTriples(pts)" />
    }
    else if (GameState.FaseActual == FaseJuego.PortadaHito)
    {
        <PortadaRevista Titular="@GameState.TitularPortada" 
                        Subtitulo="@GameState.SubtituloPortada" 
                        ImagenFondo="@GameState.ImagenPortada" 
                        OnCerrar="() => GameState.CerrarPortada()" />
    }
    else if (GameState.FaseActual == FaseJuego.MinijuegoCancha)
    {
        <CanchaTiro OnFinalizado="(exito) => GameState.ResolverMinijuego(exito)" />
    }
    else if (GameState.FaseActual == FaseJuego.MinijuegoLectura)
    {
        <LecturaJugada OnFinalizado="(exito) => GameState.ResolverMinijuego(exito)" />
    }
    else if (GameState.FaseActual == FaseJuego.MinijuegoDuelo)
    {
        <DueloUnoContraUno OnFinalizado="(exito) => GameState.ResolverMinijuego(exito)" />
    }
    else if (GameState.FaseActual == FaseJuego.Playoffs)
    {
        <div class="sports-card p-4 text-center">
            <span class="badge bg-danger text-uppercase px-3 py-1 mb-2">Postemporada NBA</span>
            <h2 class="nba-title display-5 text-white mb-1">@GameState.NombreRonda(GameState.RondaActualPlayoffs)</h2>
            <p class="text-secondary">Rival de serie: <strong class="text-white">@GameState.RivalPlayoffs</strong></p>

            <div class="alert alert-dark border border-danger my-3">
                <span class="fs-5 text-white">Serie al mejor de 3: <strong>@GameState.VictoriasSeriePlayoff - @GameState.DerrotasSeriePlayoff</strong></span>
            </div>

            @if (!string.IsNullOrEmpty(GameState.UltimaNoticia))
            {
                <div class="small text-info mb-4">@GameState.UltimaNoticia</div>
            }

            <div class="row g-2">
                <div class="col-12 col-md-6">
                    <button class="btn btn-warning w-100 py-3 fw-bold text-dark" @onclick="() => GameState.JugarPartidoPlayoff(true)">
                        Asumir Posesión en Cancha
                    </button>
                </div>
                <div class="col-12 col-md-6">
                    <button class="btn btn-outline-light w-100 py-3 fw-bold" @onclick="() => GameState.JugarPartidoPlayoff(false)">
                        Simular con @GameState.EstrellaCompanero
                    </button>
                </div>
            </div>
        </div>
    }
    else if (GameState.FaseActual == FaseJuego.FinTemporada)
    {
        <div class="sports-card p-4 text-center">
            <h2 class="nba-title display-4 text-white mb-1">TEMPORADA @GameState.TemporadaActual CONCLUIDA</h2>
            <p class="text-secondary">Récord: <strong class="text-white">@GameState.Victorias V - @GameState.Derrotas D</strong> | Saldo: <strong class="text-success">$@((GameState.DineroDisponible / 1_000_000.0).ToString("0.0"))M</strong></p>

            <div class="my-3 p-3 bg-dark rounded border border-secondary text-center">
                <span class="text-secondary small fw-bold text-uppercase d-block mb-2">Palmarés Obtenido</span>
                @if (GameState.PremiosGanadosTemporada.Any())
                {
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        @foreach (var premio in GameState.PremiosGanadosTemporada)
                        {
                            <span class="badge bg-warning text-dark p-2 fs-6">@premio</span>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted small">Sin premios alcanzados esta temporada.</span>
                }
            </div>

            <div class="card bg-dark border-secondary p-3 my-3 text-start">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-white fw-bold">DESARROLLO DE HABILIDADES</span>
                    <span class="badge bg-primary">Puntos: @GameState.PuntosDesarrollo</span>
                </div>
                <div class="row g-2">
                    <div class="col-6 d-flex justify-content-between align-items-center p-2 rounded bg-black">
                        <span class="small text-white">Tiro: @GameState.JugadorActivo?.TiroExterior</span>
                        <button class="btn btn-sm btn-outline-success" disabled="@(GameState.PuntosDesarrollo <= 0)" @onclick='() => GameState.MejorarAtributo("TiroExterior")'>+2</button>
                    </div>
                    <div class="col-6 d-flex justify-content-between align-items-center p-2 rounded bg-black">
                        <span class="small text-white">Pase: @GameState.JugadorActivo?.Pase</span>
                        <button class="btn btn-sm btn-outline-success" disabled="@(GameState.PuntosDesarrollo <= 0)" @onclick='() => GameState.MejorarAtributo("Pase")'>+2</button>
                    </div>
                    <div class="col-6 d-flex justify-content-between align-items-center p-2 rounded bg-black">
                        <span class="small text-white">Defensa: @GameState.JugadorActivo?.Defensa</span>
                        <button class="btn btn-sm btn-outline-success" disabled="@(GameState.PuntosDesarrollo <= 0)" @onclick='() => GameState.MejorarAtributo("Defensa")'>+2</button>
                    </div>
                    <div class="col-6 d-flex justify-content-between align-items-center p-2 rounded bg-black">
                        <span class="small text-white">Atletismo: @GameState.JugadorActivo?.Atletismo</span>
                        <button class="btn btn-sm btn-outline-success" disabled="@(GameState.PuntosDesarrollo <= 0)" @onclick='() => GameState.MejorarAtributo("Atletismo")'>+2</button>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button class="btn btn-outline-danger" @onclick="() => GameState.RetirarJugador()">Retirarse</button>
                <button class="btn btn-warning px-4 fw-bold text-dark" @onclick="() => GameState.AvanzarSiguienteTemporada()">Avanzar de Temporada</button>
            </div>
        </div>
    }
    else if (GameState.FaseActual == FaseJuego.AgenciaLibre)
    {
        <div class="sports-card p-4 text-center">
            <h2 class="nba-title display-4 text-warning mb-1">AGENCIA LIBRE</h2>
            <p class="text-secondary small">Vencimiento contractual. Selecciona franquicia:</p>

            <div class="row g-2 my-3">
                @foreach (var eqLibre in EquipoNBA.Franquicias.Take(4))
                {
                    <div class="col-12">
                        <button class="btn btn-choice w-100 p-3 d-flex align-items-center justify-content-between"
                                style="border-left: 5px solid @eqLibre.ColorPrimario;"
                                @onclick="() => GameState.FirmarAgenciaLibre(eqLibre.Nombre)">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@eqLibre.LogoUrl" style="height: 40px; width: 40px; object-fit: contain;" alt="@eqLibre.Nombre" />
                                <div class="text-start">
                                    <span class="fs-5 text-white d-block">@eqLibre.Nombre</span>
                                    <small class="text-secondary">Compañero: @eqLibre.EstrellaFranquicia</small>
                                </div>
                            </div>
                            <span class="badge bg-secondary">Firmar</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    }
    else if (GameState.FaseActual == FaseJuego.Retiro)
    {
        <div class="sports-card p-4 text-center">
            <h1 class="nba-title display-4 text-white mb-0">SALÓN DE LA FAMA</h1>
            <p class="text-secondary">Balance Histórico de @GameState.JugadorActivo?.Nombre (@GameState.JugadorActivo?.Pais)</p>

            @if (GameState.EnSalonDeLaFama)
            {
                <div class="p-4 my-3 rounded bg-warning text-dark shadow-lg">
                    <h2 class="nba-title mb-0 fs-1">ELEGIDO AL SALÓN DE LA FAMA</h2>
                    <p class="mb-0 fw-semibold">Tu busto de bronce descansará para siempre en Springfield.</p>
                </div>
            }
            else
            {
                <div class="p-3 my-3 rounded bg-dark border border-secondary">
                    <h5 class="text-white mb-0">Carrera Profesional Concluida</h5>
                    <p class="small text-muted mb-0">No se alcanzaron los requerimientos para el Salón de la Fama.</p>
                </div>
            }

            <div class="row g-2 text-center my-3">
                <div class="col-4 p-2 bg-dark rounded border border-secondary">Anillos: <strong>@GameState.AnillosCampeon</strong></div>
                <div class="col-4 p-2 bg-dark rounded border border-secondary">MVPs: <strong>@GameState.PremiosMVP</strong></div>
                <div class="col-4 p-2 bg-dark rounded border border-secondary">Años: <strong>@GameState.TemporadaActual</strong></div>
            </div>

            <button class="btn btn-warning py-3 px-5 fw-bold text-dark mt-3" @onclick="Reiniciar">
                Iniciar Nueva Carrera
            </button>
        </div>
    }
</div>

@code {
    private const string STORAGE_KEY = "TheNextPick_SaveState";
    private bool tienePartidaGuardada = false;
    private bool mostrarTienda = false;

    private string nombreInput = "";
    private string paisInput = "Colombia";
    private int dorsalInput = 7;
    private Posicion posicionInput = Posicion.Base;
    private RitmoSimulacion ritmoInput = RitmoSimulacion.Detallada;

    protected override async Task OnInitializedAsync()
    {
        GameState.OnStateChanged += ActualizarYGuardar;
        var guardado = await JS.InvokeAsync<string?>("localStorage.getItem", STORAGE_KEY);
        tienePartidaGuardada = !string.IsNullOrEmpty(guardado);
    }

    private async void ActualizarYGuardar()
    {
        if (GameState.FaseActual != FaseJuego.Creacion)
        {
            var json = GameState.ExportarEstadoJson();
            await JS.InvokeVoidAsync("localStorage.setItem", STORAGE_KEY, json);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CargarPartidaGuardada()
    {
        var json = await JS.InvokeAsync<string?>("localStorage.getItem", STORAGE_KEY);
        if (!string.IsNullOrEmpty(json))
        {
            GameState.ImportarEstadoJson(json);
        }
    }

    private void IniciarRutaDraft()
    {
        var jugador = new JugadorBuilder()
            .ConDatosBasicos(nombreInput, paisInput, dorsalInput, posicionInput)
            .AsignarAtributosPorPosicion()
            .Build();

        GameState.IrADraftCombine(jugador, ritmoInput);
    }

    private void IniciarRutaAleatoria()
    {
        var jugador = new JugadorBuilder()
            .ConDatosBasicos(nombreInput, paisInput, dorsalInput, posicionInput)
            .AsignarAtributosPorPosicion()
            .Build();

        var eq = EquipoNBA.Franquicias[Random.Shared.Next(EquipoNBA.Franquicias.Count)];
        GameState.IniciarRutaAleatoria(jugador, eq.Nombre, ritmoInput);
    }

    private void ElegirEquipo(string equipo)
    {
        GameState.SeleccionarEquipoDraft(equipo);
    }

    private async Task Reiniciar()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", STORAGE_KEY);
        tienePartidaGuardada = false;
        GameState.IniciarCreacion();
    }

    public void Dispose()
    {
        GameState.OnStateChanged -= ActualizarYGuardar;
    }
}
