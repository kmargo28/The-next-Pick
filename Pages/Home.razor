@page "/"
@namespace TheNextPick.Pages
@using TheNextPick.Models
@using TheNextPick.Engine
@using TheNextPick.Components
@inject GameStateService GameState
@inject IJSRuntime JS
@implements IDisposable

<div class="container py-4" style="max-width: 680px;">

    @if (GameState.FaseActual == FaseJuego.Creacion)
    {
        <!-- 1. CREACIÓN DEL JUGADOR Y CONTINUAR PARTIDA -->
        <div class="card shadow p-4 border-0">
            <h2 class="text-center fw-bold mb-2 text-primary">🏀 The Next Pick</h2>
            <p class="text-muted text-center mb-3">Crea tu prospecto y forja tu camino a la gloria en la NBA.</p>

            @if (tienePartidaGuardada)
            {
                <div class="d-grid mb-4">
                    <button class="btn btn-success py-2 fw-bold shadow-sm" @onclick="CargarPartidaGuardada">
                        💾 Continuar Carrera Guardada
                    </button>
                </div>
                <hr class="my-3" />
            }

            <div class="mb-3">
                <label class="form-label fw-semibold">Nombre del Jugador</label>
                <input class="form-control" placeholder="Ej: Marcus Vance" @bind="nombreInput" />
            </div>

            <div class="row mb-3">
                <div class="col">
                    <label class="form-label fw-semibold">Número de Jersey (#)</label>
                    <input type="number" class="form-control" min="0" max="99" @bind="dorsalInput" />
                </div>
                <div class="col">
                    <label class="form-label fw-semibold">Posición en Cancha</label>
                    <select class="form-select" @bind="posicionInput">
                        @foreach (var pos in Enum.GetValues<Posicion>())
                        {
                            <option value="@pos">@pos</option>
                        }
                    </select>
                </div>
            </div>

            <hr class="my-4" />

            <h5 class="fw-bold mb-3">Elige cómo comenzar tu carrera:</h5>
            <div class="d-grid gap-3">
                <button class="btn btn-outline-primary py-2 fw-semibold" @onclick="IniciarRutaDraft">
                    🎯 El Camino del Draft (Combine y Minijuegos)
                </button>
                <button class="btn btn-dark py-2 fw-semibold" @onclick="IniciarRutaAleatoria">
                    🎲 Equipo Aleatorio (Salto Rápido como Novato)
                </button>
            </div>
        </div>
    }
    else if (GameState.FaseActual == FaseJuego.DraftCombine)
    {
        <DraftCombine />
    }
    else if (GameState.FaseActual == FaseJuego.EleccionEquipo)
    {
        <div class="card shadow p-4 border-0 text-center">
            <h2 class="fw-bold text-success mb-2">🎉 ¡La Noche del Draft!</h2>
            <p class="text-muted">Puntos obtenidos en el Combine: <strong>@GameState.PuntosCombine pts</strong></p>

            <div class="alert alert-dark my-3">
                <h4 class="mb-0">Proyección Oficial: <strong>Pick #@GameState.PickAsignado Global</strong></h4>
            </div>

            <h5 class="fw-bold mt-4 mb-3">Las siguientes franquicias quieren seleccionarte:</h5>
            <div class="d-grid gap-2">
                @foreach (var equipo in GameState.EquiposDisponiblesDraft)
                {
                    <button class="btn btn-outline-dark py-2 fw-semibold fs-5" @onclick="() => ElegirEquipo(equipo)">
                        ✍️ Firmar con @equipo
                    </button>
                }
            </div>
        </div>
    }
    else if (GameState.FaseActual == FaseJuego.TemporadaRegular)
    {
        <div class="card shadow-sm p-3 border-0 mb-3 bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-0">@GameState.JugadorActivo?.Nombre #@GameState.JugadorActivo?.NumeroDorsal</h5>
                    <small class="text-muted">@GameState.JugadorActivo?.Posicion | @GameState.JugadorActivo?.EquipoActual (Edad: @GameState.JugadorActivo?.Edad)</small>
                </div>
                <div class="text-end">
                    <span class="badge bg-dark fs-6">@GameState.Victorias V - @GameState.Derrotas D</span>
                    <div class="small text-muted">Juego @GameState.PartidosJugados / @GameState.TotalPartidosTemporada</div>
                </div>
            </div>

            <!-- PROMEDIOS DEL JUGADOR -->
            <div class="d-flex justify-content-around bg-white p-2 rounded border mt-2 text-center small">
                <div>PTS: <strong>@GameState.JugadorActivo?.PromedioPuntos</strong></div>
                <div>REB: <strong>@GameState.JugadorActivo?.PromedioRebotes</strong></div>
                <div>AST: <strong>@GameState.JugadorActivo?.PromedioAsistencias</strong></div>
            </div>

            <!-- MEDIDORES -->
            <div class="row g-2 mt-2 text-center small fw-bold">
                <div class="col-3">
                    <div class="p-1 bg-white rounded border">
                        ⚡ @GameState.Energia%
                        <div class="progress" style="height: 4px;"><div class="progress-bar bg-warning" style="width: @GameState.Energia%"></div></div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-1 bg-white rounded border">
                        📋 DT @GameState.ConfianzaDT%
                        <div class="progress" style="height: 4px;"><div class="progress-bar bg-primary" style="width: @GameState.ConfianzaDT%"></div></div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-1 bg-white rounded border">
                        🤝 Química @GameState.Quimica%
                        <div class="progress" style="height: 4px;"><div class="progress-bar bg-success" style="width: @GameState.Quimica%"></div></div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="p-1 bg-white rounded border">
                        ⭐ Hype @GameState.Hype%
                        <div class="progress" style="height: 4px;"><div class="progress-bar bg-danger" style="width: @GameState.Hype%"></div></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- REPORTE DEL ÚLTIMO PARTIDO (BOX SCORE) -->
        @if (GameState.PartidosJugados > 0)
        {
            <div class="alert @(GameState.UltimoFueVictoria ? "alert-success" : "alert-danger") py-2 px-3 small border-0 text-center mb-2">
                @(GameState.UltimoFueVictoria ? "🔥 ¡Victoria!" : "📉 Derrota") | Tu actuación: <strong>@GameState.UltimosPuntos Pts, @GameState.UltimosRebotes Reb, @GameState.UltimasAsistencias Ast</strong>
            </div>
        }

        @if (!string.IsNullOrEmpty(GameState.UltimaNoticia))
        {
            <div class="alert alert-secondary py-2 px-3 small border-0 text-center mb-2">
                📰 <em>@GameState.UltimaNoticia</em>
            </div>
        }

        <DecisionCard />
    }
    else if (GameState.FaseActual == FaseJuego.FinTemporada)
    {
        <div class="card shadow p-4 border-0">
            <h3 class="fw-bold text-center mb-2">🏁 Cierre de Temporada @GameState.TemporadaActual</h3>
            <p class="text-center text-muted">Récord: <strong>@GameState.Victorias V - @GameState.Derrotas D</strong> con @GameState.JugadorActivo?.EquipoActual</p>

            <div class="my-3 p-3 bg-light rounded text-center">
                <h6 class="fw-bold text-uppercase text-secondary">Premios Otorgados</h6>
                @if (GameState.PremiosGanadosTemporada.Any())
                {
                    <div class="d-flex flex-wrap justify-content-center gap-2 mt-2">
                        @foreach (var premio in GameState.PremiosGanadosTemporada)
                        {
                            <span class="badge bg-warning text-dark p-2 fs-6">@premio</span>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">Sin premios individuales esta temporada.</p>
                }
            </div>

            <div class="card p-3 my-3 border">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="fw-bold mb-0">📈 Entrenamiento y Desarrollo</h5>
                    <span class="badge bg-primary fs-6">Puntos: @GameState.PuntosDesarrollo</span>
                </div>

                <div class="row g-2">
                    <div class="col-6 d-flex justify-content-between align-items-center p-2 bg-light rounded">
                        <span>🎯 Tiro Exterior: <strong>@GameState.JugadorActivo?.TiroExterior</strong></span>
                        <button class="btn btn-sm btn-outline-success" disabled="@(GameState.PuntosDesarrollo <= 0)" @onclick='() => GameState.MejorarAtributo("TiroExterior")'>+3</button>
                    </div>
                    <div class="col-6 d-flex justify-content-between align-items-center p-2 bg-light rounded">
                        <span>🏀 Pase / IQ: <strong>@GameState.JugadorActivo?.Pase</strong></span>
                        <button class="btn btn-sm btn-outline-success" disabled="@(GameState.PuntosDesarrollo <= 0)" @onclick='() => GameState.MejorarAtributo("Pase")'>+3</button>
                    </div>
                    <div class="col-6 d-flex justify-content-between align-items-center p-2 bg-light rounded">
                        <span>🛡️ Defensa: <strong>@GameState.JugadorActivo?.Defensa</strong></span>
                        <button class="btn btn-sm btn-outline-success" disabled="@(GameState.PuntosDesarrollo <= 0)" @onclick='() => GameState.MejorarAtributo("Defensa")'>+3</button>
                    </div>
                    <div class="col-6 d-flex justify-content-between align-items-center p-2 bg-light rounded">
                        <span>⚡ Atletismo: <strong>@GameState.JugadorActivo?.Atletismo</strong></span>
                        <button class="btn btn-sm btn-outline-success" disabled="@(GameState.PuntosDesarrollo <= 0)" @onclick='() => GameState.MejorarAtributo("Atletismo")'>+3</button>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <button class="btn btn-outline-danger" @onclick="() => GameState.RetirarJugador()">
                    🛑 Retirarse
                </button>
                <button class="btn btn-success px-4 fw-bold" @onclick="() => GameState.AvanzarSiguienteTemporada()">
                    Avanzar a Temporada @(GameState.TemporadaActual + 1) ⏩
                </button>
            </div>
        </div>
    }
    else if (GameState.FaseActual == FaseJuego.AgenciaLibre)
    {
        <div class="card shadow p-4 border-0 text-center">
            <h3 class="fw-bold text-primary mb-2">💼 ¡Agencia Libre!</h3>
            <p class="text-muted">Tu contrato ha finalizado. Elige tu próximo destino en la NBA.</p>

            <div class="d-grid gap-2 my-3">
                <button class="btn btn-outline-success py-2 fw-semibold" @onclick="() => GameState.FirmarAgenciaLibre(GameState.JugadorActivo?.EquipoActual ?? equiposNba[0])">
                    🤝 Renovar con @GameState.JugadorActivo?.EquipoActual
                </button>
                @foreach (var eq in equiposNba.Where(e => e != GameState.JugadorActivo?.EquipoActual).Take(3))
                {
                    <button class="btn btn-outline-dark py-2 fw-semibold" @onclick="() => GameState.FirmarAgenciaLibre(eq)">
                        ✍️ Firmar con @eq
                    </button>
                }
            </div>
        </div>
    }
    else if (GameState.FaseActual == FaseJuego.Retiro)
    {
        <div class="card shadow p-4 border-0 text-center">
            <h2 class="fw-bold mb-1">Hall of Fame & Legado Histórico</h2>
            <p class="badge bg-secondary fs-5 mt-2">@GameState.JugadorActivo?.Nombre #@GameState.JugadorActivo?.NumeroDorsal</p>

            @if (GameState.EnSalonDeLaFama)
            {
                <div class="alert alert-warning py-4 my-3 border-0 shadow-sm">
                    <h3 class="fw-bold mb-1 text-dark">⭐ ¡ELEGIDO AL SALÓN DE LA FAMA! ⭐</h3>
                    <p class="mb-0 text-dark">Tu busto de bronce descansará para siempre en Springfield.</p>
                </div>
            }
            else
            {
                <div class="alert alert-light py-3 my-3 border">
                    <h5 class="fw-bold mb-1">Carrera Finalizada</h5>
                    <p class="mb-0 text-muted">Completaste tu ciclo deportivo en la NBA.</p>
                </div>
            }

            <div class="row g-2 my-2 text-center">
                <div class="col-4 p-2 bg-light rounded">💍 Anillos: <strong>@GameState.AnillosCampeon</strong></div>
                <div class="col-4 p-2 bg-light rounded">🏆 MVPs: <strong>@GameState.PremiosMVP</strong></div>
                <div class="col-4 p-2 bg-light rounded">📅 Años: <strong>@GameState.TemporadaActual</strong></div>
            </div>

            <button class="btn btn-primary mt-4 py-2 fw-bold" @onclick="Reiniciar">
                🔄 Iniciar Nueva Carrera
            </button>
        </div>
    }
</div>

@code {
    private const string STORAGE_KEY = "TheNextPick_SaveState";
    private bool tienePartidaGuardada = false;

    private string nombreInput = "";
    private int dorsalInput = 7;
    private Posicion posicionInput = Posicion.Base;

    private readonly string[] equiposNba = new[]
    {
        "San Antonio Spurs", "Miami Heat", "Chicago Bulls",
        "Golden State Warriors", "Boston Celtics", "Los Angeles Lakers",
        "Denver Nuggets", "Milwaukee Bucks", "Dallas Mavericks"
    };

    protected override async Task OnInitializedAsync()
    {
        GameState.OnStateChanged += ActualizarYGuardar;
        var guardado = await JS.InvokeAsync<string?>("localStorage.getItem", STORAGE_KEY);
        tienePartidaGuardada = !string.IsNullOrEmpty(guardado);
    }

    private async void ActualizarYGuardar()
    {
        if (GameState.FaseActual != FaseJuego.Creacion)
        {
            var json = GameState.ExportarEstadoJson();
            await JS.InvokeVoidAsync("localStorage.setItem", STORAGE_KEY, json);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CargarPartidaGuardada()
    {
        var json = await JS.InvokeAsync<string?>("localStorage.getItem", STORAGE_KEY);
        if (!string.IsNullOrEmpty(json))
        {
            GameState.ImportarEstadoJson(json);
        }
    }

    private void IniciarRutaDraft()
    {
        var jugador = new JugadorBuilder()
            .ConDatosBasicos(nombreInput, dorsalInput, posicionInput)
            .AsignarAtributosPorPosicion()
            .Build();

        GameState.IrADraftCombine(jugador);
    }

    private void IniciarRutaAleatoria()
    {
        var jugador = new JugadorBuilder()
            .ConDatosBasicos(nombreInput, dorsalInput, posicionInput)
            .AsignarAtributosPorPosicion()
            .Build();

        var equipoRandom = equiposNba[Random.Shared.Next(equiposNba.Length)];
        GameState.IniciarRutaAleatoria(jugador, equipoRandom);
    }

    private void ElegirEquipo(string equipo)
    {
        GameState.SeleccionarEquipoDraft(equipo);
    }

    private async Task Reiniciar()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", STORAGE_KEY);
        tienePartidaGuardada = false;
        GameState.IniciarCreacion();
    }

    public void Dispose()
    {
        GameState.OnStateChanged -= ActualizarYGuardar;
    }
}
