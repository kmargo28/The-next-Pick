@namespace TheNextPick.Components
@using TheNextPick.Engine
@using TheNextPick.Models
@inject GameStateService GameState
@implements IDisposable

<div class="sports-card p-4 my-3 text-center" style="max-width: 580px; margin: auto; background: #0c1017; border: 2px solid #2d3748;">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="badge bg-warning text-dark text-uppercase px-2 py-1 small fw-bold">NBA All-Star 2027</span>
        <span class="text-white fw-bold fs-5">PUNTOS: @puntosTotales / 30</span>
    </div>

    <h4 class="text-white fw-bold mb-1">Concurso de Triples Oficial</h4>
    <p class="text-secondary small mb-2">Carro @(carroActual + 1) de 5 | Tiro @(tiroEnCarro + 1) de 5 @(tiroEnCarro == 4 ? "⭐ (MONEY BALL x2)" : "")</p>

    <!-- DUELA DE TRIPLES CON GRADAS -->
    <div class="position-relative mx-auto rounded overflow-hidden my-2" style="width: 100%; height: 200px; border: 2px solid #2d3748;">
        <CanchaFondo />

        <!-- Tirador Scott Pilgrim -->
        <div class="position-absolute" style="left: 80px; bottom: 10px;">
            <PixelArtPlayer Estado="@estadoTirador" ColorPrimario="@colorEquipo" AnchoPx="85" AltoPx="110" />
        </div>

        <!-- Carro de balones -->
        <div class="position-absolute" style="left: 155px; bottom: 20px;">
            <div class="bg-secondary rounded p-1 d-flex gap-1 border border-light">
                @for (int b = 0; b < (5 - tiroEnCarro); b++)
                {
                    <div class="rounded-circle" style="width: 10px; height: 10px; background: @(b == 0 && tiroEnCarro == 4 ? "#f59e0b" : "#e65100");"></div>
                }
            </div>
        </div>
    </div>

    <!-- BARRA CON ANCHO ESCALABLE SEGÚN ATRIBUTO DE TIRO -->
    <div class="position-relative my-3 rounded border border-secondary" style="height: 38px; background: #0b0e14; overflow: hidden;">
        <div class="position-absolute bg-success opacity-75 h-100" style="left: @zonaVerdeInicio%; width: @anchoVerde%;"></div>
        <div class="position-absolute bg-warning h-100" style="left: @posicionBarra%; width: 5px; box-shadow: 0 0 10px #f59e0b;"></div>
    </div>

    @if (!activo && !finalizado)
    {
        <button class="btn btn-warning py-3 px-5 fw-bold text-dark fs-5 mt-2" @onclick="IniciarRonda">
            COMENZAR RONDA (TIRO @(GameState.JugadorActivo?.TiroExterior))
        </button>
    }
    else if (activo)
    {
        <button class="btn btn-danger py-3 px-5 fw-bold fs-5 mt-1" @onclick="LanzarTriple">
            ¡LANZAR!
        </button>
    }

    <p class="mt-2 text-info fw-semibold small mb-0">@mensajeFeedback</p>
</div>

@code {
    [Parameter] public EventCallback<int> OnFinalizado { get; set; }

    private string estadoTirador = "Bote";
    private string colorEquipo = "#1D428A";
    private int carroActual = 0;
    private int tiroEnCarro = 0;
    private int puntosTotales = 0;
    private bool activo = false;
    private bool finalizado = false;
    private string mensajeFeedback = "Alineate en la esquina para iniciar.";

    private int posicionBarra = 0;
    private bool subiendo = true;
    private int zonaVerdeInicio = 68;
    private int anchoVerde = 7;
    private int velocidadBarra = 6;
    private CancellationTokenSource? cts;

    protected override void OnInitialized()
    {
        var eq = EquipoNBA.ObtenerPorNombre(GameState.JugadorActivo?.EquipoActual ?? "");
        colorEquipo = eq.ColorPrimario;

        // DIFICULTAD ESCALADA SEGÚN EL OVERALL DE TIRO:
        // A mayor tiro, mayor zona verde y movimiento más legible
        int tiro = GameState.JugadorActivo?.TiroExterior ?? 87;
        anchoVerde = Math.Clamp(6 + (tiro - 87), 6, 16);
        velocidadBarra = Math.Max(4, 7 - ((tiro - 87) / 4));
    }

    private async Task IniciarRonda()
    {
        activo = true;
        cts = new();
        estadoTirador = "Saltando";
        mensajeFeedback = "Presiona en la franja verde con precisión.";

        try
        {
            while (activo && !cts.Token.IsCancellationRequested)
            {
                posicionBarra += subiendo ? velocidadBarra : -velocidadBarra;
                if (posicionBarra >= 96) subiendo = false;
                if (posicionBarra <= 4) subiendo = true;
                StateHasChanged();
                await Task.Delay(16, cts.Token);
            }
        }
        catch (TaskCanceledException) { }
    }

    private async Task LanzarTriple()
    {
        estadoTirador = "Lanzando";
        bool acierto = posicionBarra >= zonaVerdeInicio && posicionBarra <= (zonaVerdeInicio + anchoVerde);
        bool esMoneyBall = (tiroEnCarro == 4);
        int puntosTiro = acierto ? (esMoneyBall ? 2 : 1) : 0;
        puntosTotales += puntosTiro;

        mensajeFeedback = acierto 
            ? (esMoneyBall ? "¡MONEY BALL ADENTRO! (+2 pts)" : "¡Triple encestado! (+1 pt)") 
            : "Tiro errado al hierro.";

        tiroEnCarro++;
        if (tiroEnCarro >= 5)
        {
            tiroEnCarro = 0;
            carroActual++;
            zonaVerdeInicio = Random.Shared.Next(35, 78);
        }

        StateHasChanged();
        await Task.Delay(150);
        estadoTirador = "Saltando";

        if (carroActual >= 5)
        {
            activo = false;
            finalizado = true;
            cts?.Cancel();
            estadoTirador = puntosTotales >= 19 ? "Celebrando" : "Bote";
            mensajeFeedback = $"Ronda completada con {puntosTotales} puntos.";
            StateHasChanged();

            await Task.Delay(1400);
            await OnFinalizado.InvokeAsync(puntosTotales);
        }
    }

    public void Dispose()
    {
        cts?.Cancel();
        cts?.Dispose();
    }
}
