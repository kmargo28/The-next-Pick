@namespace TheNextPick.Components
@implements IDisposable

<div class="sports-card p-3 my-2 text-center" style="max-width: 580px; margin: auto; background: #0c1017; border: 2px solid #2d3748;">
    
    <div class="d-flex justify-content-between align-items-center mb-2 px-2">
        <span class="badge px-3 py-1 fw-bold fs-6" style="background: #0284c7; color: #fff;">
            🎯 DIANAS DE PRECISIÓN EN EL PASE
        </span>
        <span class="badge bg-black border border-info text-info fw-bold fs-6">
            PASES: @aciertos / 6 | TIEMPO: @((int)tiempoRestante)s
        </span>
    </div>

    <!-- PISTA DE PASES CON 3 ESTACIONES METÁLICAS EN EL MURO -->
    <div class="position-relative mx-auto rounded my-3 overflow-hidden border border-secondary" 
         style="width: 100%; height: 240px; background: radial-gradient(circle at 50% 30%, #1e293b 0%, #090d16 90%);">
        <CanchaFondo />

        <!-- 3 ESTACIONES FIJAS DE DIANAS EN LA PARED -->
        <div class="position-absolute top-0 start-0 w-100 d-flex justify-content-around pt-3" style="z-index: 5;">
            @for (int e = 0; e < 3; e++)
            {
                var estacionId = e;
                var estaActiva = (estacionId == estacionObjetivo && activo);
                var nombreEstacion = e == 0 ? "IZQ" : (e == 1 ? "CENTRO" : "DER");

                <div class="text-center">
                    <!-- Diana Alta (Pecho) -->
                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2 transition-all" 
                         style="width: 44px; height: 44px; border: 2px solid @(estaActiva && !requierePicado ? "#00e676" : "#475569"); background: @(estaActiva && !requierePicado ? "#15803d" : "#1e293b");">
                        <span style="font-size: 16px;">➡️</span>
                    </div>

                    <!-- Diana Baja (Picado) -->
                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto transition-all" 
                         style="width: 44px; height: 44px; border: 2px solid @(estaActiva && requierePicado ? "#f59e0b" : "#475569"); background: @(estaActiva && requierePicado ? "#b45309" : "#1e293b");">
                        <span style="font-size: 16px;">⬇️</span>
                    </div>

                    <span class="badge @(estaActiva ? "bg-warning text-dark fw-bold" : "bg-dark text-secondary") small mt-2 d-block">
                        @nombreEstacion
                    </span>
                </div>
            }
        </div>

        <!-- BALÓN VIAJANDO DIRECTO A LA ESTACIÓN (Coordenadas en entero puro) -->
        @if (balonEnVuelo)
        {
            <div class="position-absolute" style="left: @((int)balonX)px; top: @((int)balonY)px; transform: translate(-50%, -50%); z-index: 10;">
                <svg width="24" height="24" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" fill="#e65100" stroke="#000" stroke-width="2" />
                    <line x1="2" y1="12" x2="22" y2="12" stroke="#000" stroke-width="1.5" />
                    <line x1="12" y1="2" x2="12" y2="22" stroke="#000" stroke-width="1.5" />
                </svg>
            </div>
        }

        <!-- JUGADOR PIVOTEANDO EN EL CENTRO -->
        <div class="position-absolute" style="left: 60px; bottom: 15px; z-index: 6;">
            <PixelArtPlayer Estado="@(balonEnVuelo ? "Saltando" : "Bote")" TieneBalon="@(!balonEnVuelo)" ColorPrimario="#1D428A" AnchoPx="85" AltoPx="110" />
        </div>
    </div>

    <!-- BOTONES TÁCTICOS DE EJECUCIÓN -->
    @if (!activo && !finalizado)
    {
        <button class="btn arcade-btn-3d btn-warning w-100 py-3 fw-bold text-dark fs-5" @onclick="IniciarPrueba">
            COMENZAR CIRCUITO DE PASES ⏱️
        </button>
    }
    else if (activo && !balonEnVuelo)
    {
        <div class="d-flex gap-2">
            <button class="btn arcade-btn-3d btn-danger w-50 py-3 fw-bold text-white fs-5" @onclick="() => LanzarPase(false)">
                PASE DE PECHO ➡️
            </button>
            <button class="btn arcade-btn-3d btn-warning w-50 py-3 fw-bold text-dark fs-5" @onclick="() => LanzarPase(true)">
                PASE PICADO ⬇️
            </button>
        </div>
    }
    else
    {
        <button class="btn btn-secondary w-100 py-3 fw-bold fs-5 text-muted" disabled>
            BALÓN EN EL AIRE...
        </button>
    }

    <div class="mt-2 text-info small fw-bold">@mensajeFeedback</div>
</div>

@code {
    [Parameter] public EventCallback<int> OnFinalizado { get; set; }

    private int aciertos = 0;
    private int pasesTotales = 0;
    private double tiempoRestante = 15.0;
    private bool activo = false;
    private bool finalizado = false;
    private bool balonEnVuelo = false;

    private int estacionObjetivo = 1; // 0: Izq, 1: Centro, 2: Der
    private bool requierePicado = false;

    private double balonX = 100;
    private double balonY = 170;

    private string mensajeFeedback = "Observa qué estación se enciende y qué tipo de pase exige (Pecho o Picado).";
    private CancellationTokenSource cts = new();

    private void IniciarPrueba()
    {
        activo = true;
        aciertos = 0;
        pasesTotales = 0;
        tiempoRestante = 15.0;
        GenerarNuevoObjetivo();
        IniciarCronometro();
    }

    private void GenerarNuevoObjetivo()
    {
        estacionObjetivo = Random.Shared.Next(0, 3);
        requierePicado = Random.Shared.Next(0, 2) == 1;
        var estNombre = estacionObjetivo == 0 ? "IZQUIERDA" : (estacionObjetivo == 1 ? "CENTRO" : "DERECHA");
        var tipoNombre = requierePicado ? "PASE PICADO ⬇️" : "PASE DE PECHO ➡️";
        mensajeFeedback = $"¡OBJETIVO! Estación {estNombre} exige {tipoNombre}.";
        StateHasChanged();
    }

    private void IniciarCronometro()
    {
        _ = Task.Run(async () =>
        {
            try
            {
                while (activo && tiempoRestante > 0 && !cts.Token.IsCancellationRequested)
                {
                    tiempoRestante -= 0.1;
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(100, cts.Token);
                }

                if (activo && tiempoRestante <= 0)
                {
                    await InvokeAsync(ConcluirPrueba);
                }
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task LanzarPase(bool fuePicado)
    {
        if (!activo || balonEnVuelo) return;
        balonEnVuelo = true;
        pasesTotales++;

        bool tipoCorrecto = (fuePicado == requierePicado);
        if (tipoCorrecto) aciertos++;

        // Coordenadas fijas por estación en enteros para evitar desfasajes
        int targetX = estacionObjetivo == 0 ? 100 : (estacionObjetivo == 1 ? 280 : 460);
        int targetY = requierePicado ? 95 : 42;

        balonX = 100;
        balonY = 170;

        for (int i = 0; i <= 14; i++)
        {
            double t = i / 14.0;
            balonX = (1 - t) * 100 + t * targetX;
            balonY = fuePicado ? (1 - t) * (1 - t) * 170 + 2 * (1 - t) * t * 205 + t * t * targetY
                               : (1 - t) * 170 + t * targetY;
            StateHasChanged();
            await Task.Delay(16);
        }

        mensajeFeedback = tipoCorrecto ? "¡DIANA CERTERA EN EL BLANCO! 🎯" : "¡Pase erróneo! No coincide con el esquema exigido.";
        await Task.Delay(260);
        balonEnVuelo = false;

        if (pasesTotales >= 6)
        {
            await ConcluirPrueba();
        }
        else
        {
            GenerarNuevoObjetivo();
        }
    }

    private async Task ConcluirPrueba()
    {
        activo = false;
        finalizado = true;
        try { cts.Cancel(); } catch { }

        int puntos = Math.Clamp(aciertos * 3 + 2, 0, 20);
        mensajeFeedback = $"Prueba de pases finalizada: {aciertos}/6 aciertos (+{puntos} PTS).";
        StateHasChanged();

        await Task.Delay(1100);
        await OnFinalizado.InvokeAsync(puntos);
    }

    public void Dispose()
    {
        activo = false;
        try { cts.Cancel(); } catch { }
        try { cts.Dispose(); } catch { }
    }
}
