@namespace TheNextPick.Components
@using TheNextPick.Engine
@inject GameStateService GameState
@implements IDisposable

<div class="sports-card p-3 my-2 text-center" style="max-width: 640px; margin: auto; background: #080c14; border: 3px solid #FFC72C; box-shadow: 0 0 35px rgba(255,199,44,0.35);">
    
    <!-- ENCABEZADO OFICIAL DE ALL-STAR WEEKEND -->
    <div class="d-flex justify-content-between align-items-center mb-2 px-2 pb-2 border-bottom border-secondary">
        <span class="badge px-3 py-1 fw-bold fs-6" style="background: #FFC72C; color: #000;">
            ⭐ ALL-STAR 3-POINT CONTEST
        </span>
        <div class="text-end">
            <span class="badge bg-black border border-warning text-warning fw-bold fs-5">
                PUNTOS: @puntosTotales / 30 PTS
            </span>
            <div class="text-secondary small fw-bold">TIEMPO: @((int)tiempoRestante)s</div>
        </div>
    </div>

    <h3 class="text-white fw-bold nba-title mb-1">CARRO @(carroActual + 1) DE 5: @NombreEstacionCarro(carroActual)</h3>
    <p class="text-secondary small mb-2">
        Balón regular = 1 PT | Money Ball tricolor = 2 PTS. Suelta el tiro en la zona verde antes de que expire el reloj.
    </p>

    <!-- PISTA CON EL JUGADOR EN EL CARRO ACTIVO -->
    <div class="position-relative mx-auto rounded my-3 overflow-hidden border border-secondary" 
         style="width: 100%; height: 250px; background: #06090f;">
        <CanchaFondo />

        <!-- Canasta fija -->
        <svg viewBox="0 0 140 180" class="position-absolute end-0" style="width: 120px; height: 160px; top: 25px; pointer-events: none; z-index: 5;">
            <line x1="110" y1="10" x2="110" y2="160" stroke="#000" stroke-width="8" />
            <line x1="110" y1="10" x2="110" y2="160" stroke="#cbd5e1" stroke-width="4" />
            <rect x="95" y="15" width="8" height="60" fill="#fff" stroke="#000" stroke-width="2" />
            <rect x="97" y="32" width="4" height="26" fill="none" stroke="#e11d48" stroke-width="2" />
            <line x1="58" y1="52" x2="95" y2="52" stroke="#ff4500" stroke-width="5" stroke-linecap="round" />
            <ellipse cx="76" cy="52" rx="16" ry="3.5" fill="none" stroke="#000" stroke-width="3" />
            <ellipse cx="76" cy="52" rx="15" ry="3" fill="none" stroke="#ff4500" stroke-width="2" />
        </svg>

        <!-- CARRO DE BALONES FÍSICO AL LADO DEL JUGADOR -->
        <div class="position-absolute" style="left: @(posicionXCarroPx - 35)px; bottom: 25px; z-index: 6;">
            <div class="p-1 rounded border border-warning" style="background: #1e293b; width: 30px;">
                @for (int b = 4; b >= 0; b--)
                {
                    var balonDisponible = (b >= balonEnCarro);
                    var esMoney = (b == 4);
                    <div class="rounded-circle my-1 mx-auto" 
                         style="width: 12px; height: 12px; background: @(balonDisponible ? (esMoney ? "#00f0ff" : "#ea580c") : "#334155"); border: 1px solid #000;">
                    </div>
                }
            </div>
            <span class="badge bg-black text-warning small mt-1" style="font-size: 0.55rem;">RACK</span>
        </div>

        <!-- BALÓN VOLANDO EN PARÁBOLA -->
        @if (balonVolando)
        {
            <div class="position-absolute" style="left: @((int)balonX)px; top: @((int)balonY)px; transform: translate(-50%, -50%); z-index: 15;">
                <svg width="24" height="24" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" fill="@(tiroFueMoneyBall ? "#00f0ff" : "#e65100")" stroke="#000" stroke-width="2" />
                    <line x1="2" y1="12" x2="22" y2="12" stroke="#000" stroke-width="1.5" />
                    <line x1="12" y1="2" x2="12" y2="22" stroke="#000" stroke-width="1.5" />
                </svg>
            </div>
        }

        <!-- JUGADOR DISPARANDO EN EL CARRO ACTIVO -->
        <div class="position-absolute" style="left: @posicionXCarroPx; bottom: 20px; transition: left 0.3s ease-out; z-index: 7;">
            <PixelArtPlayer Estado="@estadoJugador" TieneBalon="@(!balonVolando)" ColorPrimario="#1D428A" NumeroDorsal="@(GameState.JugadorActivo?.NumeroDorsal ?? 11)" AnchoPx="90" AltoPx="115" />
        </div>
    </div>

    <!-- MEDIDOR DE DISPARO CON ZONA VERDE CALIBRADA -->
    <div class="position-relative my-3 rounded border border-secondary" style="height: 38px; background: #000; overflow: hidden;">
        <div class="position-absolute bg-success h-100" style="left: 64%; width: 14%; box-shadow: 0 0 15px #10b981; opacity: 0.9;"></div>
        <div class="position-absolute bg-warning h-100" style="left: @posicionAguja%; width: 6px; box-shadow: 0 0 12px #f59e0b;"></div>
    </div>

    <!-- BOTONES ARCADE -->
    @if (!activo && !finalizado)
    {
        <button class="btn arcade-btn-3d btn-warning w-100 py-3 fw-bold text-dark fs-4" @onclick="IniciarConcurso">
            TOMAR POSICIÓN EN EL PRIMER CARRO 🏀
        </button>
    }
    else if (activo && !balonVolando)
    {
        <button class="btn arcade-btn-3d @(balonEnCarro == 4 ? "btn-info text-dark" : "btn-danger text-white") w-100 py-3 fw-bold fs-4" @onclick="SoltarTiro">
            @(balonEnCarro == 4 ? "⭐ ¡LANZAR MONEY BALL! (2 PTS)" : $"🎯 LANZAR BALÓN ({balonEnCarro + 1}/5)")
        </button>
    }
    else
    {
        <button class="btn btn-secondary w-100 py-3 fw-bold fs-4 text-muted" disabled>
            BALÓN EN EL AIRE...
        </button>
    }

    <div class="mt-2 text-info small fw-bold">@mensajeFeedback</div>
</div>

@code {
    [Parameter] public EventCallback<int> OnFinalizado { get; set; }

    private int carroActual = 0; // 0 a 4
    private int balonEnCarro = 0; // 0 a 4 (el 4 es el Money Ball)
    private int puntosTotales = 0;
    private double tiempoRestante = 45.0;

    private bool activo = false;
    private bool finalizado = false;
    private bool balonVolando = false;
    private bool tiroFueMoneyBall = false;

    private int posicionAguja = 0;
    private bool subiendo = true;
    private string estadoJugador = "Bote";

    private double balonX = 110;
    private double balonY = 160;
    private string mensajeFeedback = "Acierta en la zona verde con cadencia rápida para vaciar los 5 carros.";
    private CancellationTokenSource cts = new();

    private int posicionXCarroPx => 80 + (carroActual * 45);

    private string NombreEstacionCarro(int c) => c switch
    {
        0 => "Esquina Izquierda",
        1 => "45° Izquierda",
        2 => "Cabecera Frontal",
        3 => "45° Derecha",
        4 => "Esquina Derecha",
        _ => "Rack"
    };

    private void IniciarConcurso()
    {
        activo = true;
        carroActual = 0;
        balonEnCarro = 0;
        puntosTotales = 0;
        tiempoRestante = 45.0;
        IniciarLoopAguja();
        IniciarCronometro();
    }

    private void IniciarLoopAguja()
    {
        _ = Task.Run(async () =>
        {
            try
            {
                while (activo && !cts.Token.IsCancellationRequested)
                {
                    posicionAguja += subiendo ? 5 : -5;
                    if (posicionAguja >= 95) subiendo = false;
                    if (posicionAguja <= 5) subiendo = true;

                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(16, cts.Token);
                }
            }
            catch (OperationCanceledException) { }
        });
    }

    private void IniciarCronometro()
    {
        _ = Task.Run(async () =>
        {
            try
            {
                while (activo && tiempoRestante > 0 && !cts.Token.IsCancellationRequested)
                {
                    tiempoRestante -= 0.1;
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(100, cts.Token);
                }

                if (activo && tiempoRestante <= 0)
                {
                    await InvokeAsync(TerminarPorTiempo);
                }
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task SoltarTiro()
    {
        if (balonVolando || !activo) return;
        balonVolando = true;
        estadoJugador = "Saltando";

        bool esMoneyBall = (balonEnCarro == 4);
        tiroFueMoneyBall = esMoneyBall;

        bool acierto = posicionAguja >= 64 && posicionAguja <= 78;
        if (acierto)
        {
            puntosTotales += esMoneyBall ? 2 : 1;
            mensajeFeedback = esMoneyBall ? "¡MONEY BALL ADENTRO! (+2 PTS) 🔥" : "¡Triple encestado! (+1 PT) 🎯";
        }
        else
        {
            mensajeFeedback = "¡Fallo! El balón golpea el aro ❌";
        }

        balonX = posicionXCarroPx + 20;
        balonY = 150;
        StateHasChanged();

        double destinoX = acierto ? 520 : 475;
        double destinoY = 95;

        for (int i = 0; i <= 15; i++)
        {
            double t = i / 15.0;
            balonX = (1 - t) * (posicionXCarroPx + 20) + t * destinoX;
            balonY = (1 - t) * (1 - t) * 150 + 2 * (1 - t) * t * 20 + t * t * destinoY;
            StateHasChanged();
            await Task.Delay(15);
        }

        await Task.Delay(180);
        balonVolando = false;
        estadoJugador = "Bote";

        balonEnCarro++;
        if (balonEnCarro >= 5)
        {
            balonEnCarro = 0;
            carroActual++;

            if (carroActual >= 5)
            {
                await ConcluirConcurso();
                return;
            }
        }
        StateHasChanged();
    }

    private async Task TerminarPorTiempo()
    {
        mensajeFeedback = "¡TIEMPO AGOTADO EN EL ALL-STAR!";
        await ConcluirConcurso();
    }

    private async Task ConcluirConcurso()
    {
        activo = false;
        finalizado = true;
        try { cts.Cancel(); } catch { }

        mensajeFeedback = $"Concurso concluido: ¡{puntosTotales} PUNTOS!";
        StateHasChanged();

        await Task.Delay(1200);
        await OnFinalizado.InvokeAsync(puntosTotales);
    }

    public void Dispose()
    {
        activo = false;
        try { cts.Cancel(); } catch { }
        try { cts.Dispose(); } catch { }
    }
}
