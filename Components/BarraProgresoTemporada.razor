@namespace TheNextPick.Components
@using TheNextPick.Engine
@inject GameStateService GameState

<div class="sports-card p-3 mb-3" style="background: #090d16; border: 2px solid #1e293b; box-shadow: 0 4px 20px rgba(0,0,0,0.5);">
    
    <!-- CABECERA DE LA BARRA -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-warning text-dark fw-bold px-2 py-1" style="font-size: 0.7rem;">CALENDARIO NBA</span>
            <span class="text-white small fw-bold">CALENDARIO REGULAR (82 PARTIDOS)</span>
        </div>
        <div class="text-end">
            <span class="text-info fw-bold font-monospace small">@GameState.PartidosJugados / 82 · @PorcentajeAvance()% COMPLETADO</span>
        </div>
    </div>

    <!-- BARRA VISUAL DE PORCENTAJE RETRO CON ILUMINACIÓN NEÓN -->
    <div class="position-relative my-2 rounded overflow-hidden" style="height: 14px; background: #030712; border: 1px solid #334155;">
        <div class="h-100 progress-glow" 
             style="width: @PorcentajeAvance()%; background: linear-gradient(90deg, #10b981 0%, #f59e0b 50%, #00f0ff 100%); transition: width 0.4s ease-out;">
        </div>
    </div>

    <!-- HITOS Y ESTACIONES DE LA TEMPORADA -->
    <div class="d-flex justify-content-between text-center mt-2" style="font-size: 0.68rem;">
        
        <!-- HITO 1: TIP-OFF -->
        <div class="season-stage-node @(FaseIndice >= 1 ? "node-active text-warning" : "text-muted")">
            <span class="d-block fs-6">🏀</span>
            <span class="fw-bold d-block">TIP-OFF</span>
            <span class="node-sub">Partidos 1-20</span>
        </div>

        <!-- HITO 2: TRADE DEADLINE -->
        <div class="season-stage-node @(FaseIndice >= 2 ? "node-active text-danger" : "text-muted")">
            <span class="d-block fs-6">❄️</span>
            <span class="fw-bold d-block">DEADLINE</span>
            <span class="node-sub">Partidos 21-40</span>
        </div>

        <!-- HITO 3: ALL-STAR BREAK -->
        <div class="season-stage-node @(FaseIndice >= 3 ? "node-active text-info" : "text-muted")">
            <span class="d-block fs-6">⭐</span>
            <span class="fw-bold d-block">ALL-STAR</span>
            <span class="node-sub">Partido 41</span>
        </div>

        <!-- HITO 4: RECTA FINAL -->
        <div class="season-stage-node @(FaseIndice >= 4 ? "node-active text-success" : "text-muted")">
            <span class="d-block fs-6">🔥</span>
            <span class="fw-bold d-block">FINAL PUSH</span>
            <span class="node-sub">Partidos 42-70</span>
        </div>

        <!-- HITO 5: CIERRE -->
        <div class="season-stage-node @(FaseIndice >= 5 ? "node-active text-light" : "text-muted")">
            <span class="d-block fs-6">🏁</span>
            <span class="fw-bold d-block">PLAYOFF RACE</span>
            <span class="node-sub">Partidos 71-82</span>
        </div>

    </div>

</div>

<style>
    .progress-glow {
        box-shadow: 0 0 12px rgba(0, 240, 255, 0.7);
    }
    .season-stage-node {
        flex: 1;
        transition: all 0.2s ease-in-out;
    }
    .node-active {
        font-weight: 800;
        transform: translateY(-2px);
    }
    .node-sub {
        font-size: 0.6rem;
        color: #64748b;
        display: block;
    }
</style>

@code {
    private int PorcentajeAvance()
    {
        int dec = GameState.PartidosJugados;
        int tot = Math.Max(1, GameStateService.TotalPartidosTemporada);
        return Math.Clamp((dec * 100) / tot, 0, 100);
    }

    private int FaseIndice => GameState.PartidosJugados switch
    {
        <= 20 => 1,
        <= 40 => 2,
        41 => 3,
        <= 70 => 4,
        _ => 5
    };
}
