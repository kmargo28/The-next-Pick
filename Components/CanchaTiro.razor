@namespace TheNextPick.Components
@implements IDisposable

<div class="sports-card p-3 my-3 text-center position-relative" style="max-width: 460px; margin: auto; background: #0b0e14; border: 1px solid rgba(255, 255, 255, 0.15);">
    <div class="d-flex justify-content-between align-items-center mb-2 px-2">
        <span class="badge bg-danger text-uppercase px-2 py-1 small fw-bold">Posesion Clutch</span>
        <span class="text-white small fw-bold">CANASTAS: @canastas / 3 (Intento @(Math.Min(intentos + 1, 3))/3)</span>
    </div>

    <!-- PISTA DE JUEGO INTERACTIVA SVG -->
    <div class="position-relative mx-auto rounded overflow-hidden" 
         style="width: 320px; height: 320px; background: radial-gradient(circle at 50% 20%, #1f2737 0%, #0d1117 80%); border: 2px solid #2d3748; touch-action: none; user-select: none;"
         @onpointerdown="HandlePointerDown"
         @onpointermove="HandlePointerMove"
         @onpointerup="HandlePointerUp">

        <svg viewBox="0 0 320 320" style="width: 100%; height: 100%; pointer-events: none;">
            <!-- Lineas oficiales de cancha -->
            <path d="M 30,0 L 30,40 A 130,130 0 0,0 290,40 L 290,0" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="2" />
            <rect x="110" y="0" width="100" height="110" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="2" />
            <circle cx="160" cy="110" r="35" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="2" stroke-dasharray="4" />

            <!-- Tablero y Aro -->
            <line x1="120" y1="22" x2="200" y2="22" stroke="#ffffff" stroke-width="5" />
            <circle cx="160" cy="36" r="14" fill="none" stroke="#e65100" stroke-width="4" />
            <path d="M 148,36 Q 160,58 172,36" fill="none" stroke="#ffffff" stroke-width="2" opacity="0.6" />

            <!-- Vector de mira y fuerza -->
            @if (arrastrando)
            {
                <line x1="160" y1="240" 
                      x2="@(160 - (desvioX * 1.5))" y2="@(240 - (tensionY * 1.8))" 
                      stroke="#f59e0b" stroke-width="3" stroke-dasharray="4" />
                
                <!-- Circulo diana objetivo -->
                <circle cx="@(160 - (desvioX * 1.5))" cy="@(240 - (tensionY * 1.8))" r="8" fill="none" stroke="#f59e0b" stroke-width="1.5" />
            }

            <!-- Balón con sombra -->
            <g transform="translate(@balonX, @balonY)">
                <circle cx="0" cy="3" r="15" fill="rgba(0,0,0,0.4)" />
                <circle cx="0" cy="0" r="15" fill="#e65100" stroke="#000000" stroke-width="2" />
                <path d="M -15,0 A 15,15 0 0,0 15,0" fill="none" stroke="#000" stroke-width="1.5" />
                <path d="M 0,-15 A 15,15 0 0,0 0,15" fill="none" stroke="#000" stroke-width="1.5" />
            </g>
        </svg>

        @if (arrastrando)
        {
            <div class="position-absolute bottom-0 start-50 translate-middle-x mb-2 px-2 py-1 rounded bg-black border border-secondary text-warning small fw-bold">
                POTENCIA: @((int)tensionY)% | DESVIO: @((int)Math.Abs(desvioX))px
            </div>
        }
    </div>

    <div class="mt-2 text-warning fw-semibold small">@mensajeGuia</div>
</div>

@code {
    [Parameter] public EventCallback<bool> OnFinalizado { get; set; }

    private double balonX = 160;
    private double balonY = 240;
    private double startPointerX;
    private double startPointerY;
    private double desvioX = 0;
    private double tensionY = 0;
    private bool arrastrando = false;
    private bool animandoTiro = false;
    private int intentos = 0;
    private int canastas = 0;
    private string mensajeGuia = "Toca el balon, arrastra hacia abajo para tensar y suelta.";
    private CancellationTokenSource cts = new();

    private void HandlePointerDown(PointerEventArgs e)
    {
        if (animandoTiro || intentos >= 3) return;
        arrastrando = true;
        startPointerX = e.ClientX;
        startPointerY = e.ClientY;
        desvioX = 0;
        tensionY = 0;
    }

    private void HandlePointerMove(PointerEventArgs e)
    {
        if (!arrastrando || animandoTiro) return;
        desvioX = Math.Clamp((e.ClientX - startPointerX) * 0.8, -50, 50);
        tensionY = Math.Clamp((e.ClientY - startPointerY) * 0.9, 0, 95);

        balonX = 160 + desvioX;
        balonY = 240 + (tensionY * 0.35);
    }

    private async Task HandlePointerUp(PointerEventArgs e)
    {
        if (!arrastrando || animandoTiro) return;
        arrastrando = false;
        animandoTiro = true;
        intentos++;

        // Regla de tiro limpia: tensión entre 50 y 85 con desviación menor a 15px
        bool acierto = tensionY >= 48 && tensionY <= 85 && Math.Abs(desvioX) <= 15;

        // Trayectoria hacia el aro
        balonX = acierto ? 160 : (160 + (desvioX * 1.3));
        balonY = acierto ? 36 : 18;
        StateHasChanged();

        try
        {
            await Task.Delay(400, cts.Token);
            if (acierto)
            {
                canastas++;
                mensajeGuia = "¡Tiro impecable! Red sacudida.";
            }
            else
            {
                mensajeGuia = tensionY < 48 ? "Tiro corto sin fuerza." : "Tiro desviado al aro.";
            }
            StateHasChanged();

            await Task.Delay(750, cts.Token);

            if (intentos >= 3)
            {
                await OnFinalizado.InvokeAsync(canastas >= 2);
            }
            else
            {
                balonX = 160;
                balonY = 240;
                animandoTiro = false;
                mensajeGuia = "Apunta el siguiente lanzamiento.";
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}
