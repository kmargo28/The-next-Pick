@namespace TheNextPick.Components
@implements IDisposable

<div class="sports-card p-3 my-2 text-center" style="max-width: 600px; margin: auto; background: #0c1017; border: 2px solid #2d3748;">
    
    <div class="d-flex justify-content-between align-items-center mb-2 px-2">
        <span class="badge px-3 py-1 fw-bold fs-6" style="background: #10b981; color: #000;">
            🎯 PULL-UP JUMPER EN CARRERA
        </span>
        <span class="badge bg-black border border-success text-success fw-bold fs-6">
            CANASTAS: @canastas / 4 (TIRO @(Math.Min(tiroActual, 4))/4)
        </span>
    </div>

    <!-- PISTA CON MOVIMIENTO EN CARRERA -->
    <div class="position-relative mx-auto rounded my-3 overflow-hidden border border-secondary" 
         style="width: 100%; height: 240px; background: #080c14;">
        <CanchaFondo />

        <!-- Canasta oficial -->
        <svg viewBox="0 0 140 180" class="position-absolute end-0" style="width: 120px; height: 160px; top: 25px; pointer-events: none; z-index: 5;">
            <line x1="110" y1="10" x2="110" y2="160" stroke="#000" stroke-width="8" />
            <line x1="110" y1="10" x2="110" y2="160" stroke="#cbd5e1" stroke-width="4" />
            <rect x="95" y="15" width="8" height="60" fill="#fff" stroke="#000" stroke-width="2" />
            <rect x="97" y="32" width="4" height="26" fill="none" stroke="#e11d48" stroke-width="2" />
            <line x1="58" y1="52" x2="95" y2="52" stroke="#ff4500" stroke-width="5" stroke-linecap="round" />
            <ellipse cx="76" cy="52" rx="16" ry="3.5" fill="none" stroke="#000" stroke-width="3" />
            <ellipse cx="76" cy="52" rx="15" ry="3" fill="none" stroke="#ff4500" stroke-width="2" />
        </svg>

        <!-- Marca de freno en el parqué -->
        <div class="position-absolute bottom-0 translate-middle-x pb-3" style="left: 45%; z-index: 4;">
            <div class="rounded-pill px-3 py-1 border border-2 border-warning text-warning small fw-bold bg-black shadow">
                MARCA DE FRENO 🛑
            </div>
        </div>

        <!-- Balón en vuelo -->
        @if (balonVolando)
        {
            <div class="position-absolute" style="left: @((int)balonX)px; top: @((int)balonY)px; transform: translate(-50%, -50%); z-index: 15;">
                <svg width="24" height="24" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" fill="#e65100" stroke="#000" stroke-width="2" />
                    <line x1="2" y1="12" x2="22" y2="12" stroke="#000" stroke-width="1.5" />
                    <line x1="12" y1="2" x2="12" y2="22" stroke="#000" stroke-width="1.5" />
                </svg>
            </div>
        }

        <!-- Jugador en carrera o frenado -->
        <div class="position-absolute" style="left: @((int)jugadorX)px; bottom: 20px; z-index: 6;">
            <PixelArtPlayer Estado="@estadoJugador" TieneBalon="@(!balonVolando)" ColorPrimario="#1D428A" AnchoPx="90" AltoPx="115" />
        </div>
    </div>

    <!-- MEDIDOR DE TIRO EN SUSPENSIÓN (Activo en fase de disparo) -->
    <div class="position-relative my-3 rounded border border-secondary" style="height: 38px; background: #000; overflow: hidden;">
        <div class="position-absolute bg-success h-100" style="left: 65%; width: 14%; box-shadow: 0 0 15px #10b981; opacity: 0.9;"></div>
        <div class="position-absolute bg-warning h-100" style="left: @posicionAguja%; width: 6px; box-shadow: 0 0 10px #f59e0b;"></div>
    </div>

    <!-- BOTONES ARCADE -->
    @if (!activo && !finalizado)
    {
        <button class="btn arcade-btn-3d btn-warning w-100 py-3 fw-bold text-dark fs-5" @onclick="IniciarRonda">
            INICIAR SERIE DE TIROS EN CARRERA 🏀
        </button>
    }
    else if (faseTiro == 1)
    {
        <button class="btn arcade-btn-3d btn-danger w-100 py-3 fw-bold text-white fs-4" @onclick="ClavarTalones">
            🛑 ¡CLAVAR TALONES! (FRENAR EN LA MARCA)
        </button>
    }
    else if (faseTiro == 2 && !balonVolando)
    {
        <button class="btn arcade-btn-3d btn-warning w-100 py-3 fw-bold text-dark fs-4" @onclick="SoltarTiro">
            🎯 ¡SOLTAR PULL-UP! (EN VERDE)
        </button>
    }
    else
    {
        <button class="btn btn-secondary w-100 py-3 fw-bold fs-5 text-muted" disabled>
            PROCESANDO TIRO...
        </button>
    }

    <div class="mt-2 text-info small fw-bold">@mensajeFeedback</div>
</div>

@code {
    [Parameter] public EventCallback<int> OnFinalizado { get; set; }

    private int tiroActual = 1;
    private int canastas = 0;
    private bool activo = false;
    private bool finalizado = false;
    private bool balonVolando = false;

    private int faseTiro = 1; // 1: Carrera/Freno, 2: Suspensión/Tiro
    private double jugadorX = 40;
    private bool corriendoHaciaMarca = true;

    private int posicionAguja = 0;
    private bool agujaSubiendo = true;
    private string estadoJugador = "Bote";

    private double balonX = 220;
    private double balonY = 160;
    private string mensajeFeedback = "Pulsa Clavar Talones justo al pasar por la marca de freno.";
    private CancellationTokenSource cts = new();

    private void IniciarRonda()
    {
        activo = true;
        tiroActual = 1;
        canastas = 0;
        PrepararIntento();
    }

    private void PrepararIntento()
    {
        faseTiro = 1;
        jugadorX = 40;
        corriendoHaciaMarca = true;
        estadoJugador = "Bote";
        posicionAguja = 0;
        balonVolando = false;
        mensajeFeedback = "Corriendo... ¡frena sobre la marca amarilla!";
        IniciarCarreraJugador();
    }

    private void IniciarCarreraJugador()
    {
        _ = Task.Run(async () =>
        {
            try
            {
                while (faseTiro == 1 && activo && !cts.Token.IsCancellationRequested)
                {
                    jugadorX += corriendoHaciaMarca ? 6 : -6;
                    if (jugadorX >= 260) corriendoHaciaMarca = false;
                    if (jugadorX <= 40) corriendoHaciaMarca = true;

                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(25, cts.Token);
                }
            }
            catch (OperationCanceledException) { }
        });
    }

    private void ClavarTalones()
    {
        if (faseTiro != 1) return;
        faseTiro = 2;

        // Evaluación de freno sobre la marca (rango 180 a 240)
        bool frenoLimpio = jugadorX >= 180 && jugadorX <= 240;
        estadoJugador = "Saltando";

        mensajeFeedback = frenoLimpio ? "¡Parada en un tiempo perfecta! ¡Ahora tira en verde!"
                                      : "Freno desequilibrado. La barra de tiro será más rápida.";

        IniciarCicloTiro(frenoLimpio ? 18 : 11);
    }

    private void IniciarCicloTiro(int velocidadMs)
    {
        _ = Task.Run(async () =>
        {
            try
            {
                while (faseTiro == 2 && !balonVolando && !cts.Token.IsCancellationRequested)
                {
                    posicionAguja += agujaSubiendo ? 5 : -5;
                    if (posicionAguja >= 95) agujaSubiendo = false;
                    if (posicionAguja <= 5) agujaSubiendo = true;

                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(velocidadMs, cts.Token);
                }
            }
            catch (OperationCanceledException) { }
        });
    }

    private async Task SoltarTiro()
    {
        if (balonVolando) return;
        balonVolando = true;

        bool acierto = posicionAguja >= 65 && posicionAguja <= 79;
        if (acierto) canastas++;

        balonX = jugadorX + 25;
        balonY = 145;
        StateHasChanged();

        double destinoX = acierto ? 520 : 475;
        double destinoY = 95;

        for (int i = 0; i <= 18; i++)
        {
            double t = i / 18.0;
            balonX = (1 - t) * (jugadorX + 25) + t * destinoX;
            balonY = (1 - t) * (1 - t) * 145 + 2 * (1 - t) * t * 10 + t * t * destinoY;
            StateHasChanged();
            await Task.Delay(16);
        }

        mensajeFeedback = acierto ? "¡SWISH! Canasta en suspensión impecable 🎯" : "¡CLANK! Tiro desajustado por inercia ❌";
        await Task.Delay(400);

        if (tiroActual >= 4)
        {
            activo = false;
            finalizado = true;
            try { cts.Cancel(); } catch { }
            int puntos = canastas * 5; // 4 tiros x 5 = 20 pts max
            mensajeFeedback = $"Serie completada: {canastas}/4 canastas (+{puntos} PTS).";
            StateHasChanged();
            await Task.Delay(1100);
            await OnFinalizado.InvokeAsync(puntos);
        }
        else
        {
            tiroActual++;
            PrepararIntento();
        }
    }

    public void Dispose()
    {
        activo = false;
        try { cts.Cancel(); } catch { }
        try { cts.Dispose(); } catch { }
    }
}
