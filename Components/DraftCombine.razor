@namespace TheNextPick.Components
@using TheNextPick.Engine
@inject GameStateService GameState

<div class="sports-card p-4 text-center my-3" style="max-width: 660px; margin: auto; background: #0c1017; border: 2px solid #2d3748;">
    <div class="mb-3">
        <h1 class="nba-title text-white mt-1 mb-0 display-5">NBA DRAFT COMBINE</h1>
        <span class="badge bg-warning text-dark fs-6 px-3 py-1 fw-bold mt-1">PUNTUACIÓN TOTAL: @puntosTotales / 100 PTS</span>
    </div>

    @if (etapa == 1)
    {
        <VerticalLeapDrill OnFinalizado="(pts) => AvanzarPrueba(pts, 2)" />
    }
    else if (etapa == 2)
    {
        <SprintTresCuartos OnFinalizado="(pts) => AvanzarPrueba(pts, 3)" />
    }
    else if (etapa == 3)
    {
        <LaneAgilityDrill OnFinalizado="(pts) => AvanzarPrueba(pts, 4)" />
    }
    else if (etapa == 4)
    {
        <ReactionLightsDrill OnFinalizado="(pts) => AvanzarPrueba(pts, 5)" />
    }
    else if (etapa == 5)
    {
        <TiroEstacionarioCombine OnFinalizado="(pts) => AvanzarPrueba(pts, 6)" />
    }
    else if (etapa == 6)
    {
        <div class="p-4 rounded bg-dark border border-warning text-center">
            <span class="badge bg-warning text-dark fw-bold fs-6 mb-2">EVALUACIÓN DE SCOUTS COMPLETADA</span>
            <h2 class="text-white fw-bold mb-2">Marca Final: @puntosTotales / 100 Puntos</h2>
            <p class="text-secondary small mb-4">
                @(puntosTotales >= 85 ? "Rendimiento histórico de Top Pick. Tu nombre suena con fuerza en el #1 del Draft." :
                  puntosTotales >= 65 ? "Buen rendimiento físico de primera ronda de lotería." :
                  puntosTotales >= 40 ? "Rendimiento promedio de final de primera ronda." :
                  "Rendimiento deficiente. Los scouts te proyectan para la segunda ronda del Draft.")
            </p>
            <button class="btn btn-success py-3 px-5 fw-bold text-white fs-4 w-100" @onclick="FinalizarDraftDefinitivo">
                ESCUCHAR LA CEREMONIA DEL DRAFT 🏆
            </button>
        </div>
    }
</div>

@code {
    private int etapa = 1;
    private int puntosTotales = 0;

    private void AvanzarPrueba(int puntosPrueba, int siguienteEtapa)
    {
        puntosTotales += puntosPrueba;
        etapa = siguienteEtapa;
        StateHasChanged();
    }

    private void FinalizarDraftDefinitivo()
    {
        GameState.FinalizarCombine(puntosTotales);
    }
}
