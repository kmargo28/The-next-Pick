@namespace TheNextPick.Components
@using TheNextPick.Engine
@inject GameStateService GameState
@implements IDisposable

<div class="card shadow p-4 border-0 text-center" style="max-width: 600px; margin: auto;">
    <h3 class="fw-bold text-primary mb-1">🏀 NBA Draft Combine</h3>
    <p class="text-muted mb-4">Demuestra tus habilidades ante los ojeadores para escalar posiciones en el Draft.</p>

    @if (etapaMinijuego == 1)
    {
        <!-- MINIJUEGO 1: PRECISIÓN DE TIRO -->
        <h5 class="fw-bold">Prueba 1: Tiro de Suspensión (@tirosRealizados/3)</h5>
        <p class="small text-muted">Detén la barra en la zona verde (70% - 85%) para encestar.</p>

        <div class="position-relative bg-light rounded my-4" style="height: 38px; border: 2px solid #333; overflow: hidden;">
            <div class="position-absolute bg-success opacity-75 h-100" style="left: 70%; width: 15%;"></div>
            <div class="position-absolute bg-danger h-100" style="left: @(posicionBarra)%; width: 6px; transition: left 16ms linear;"></div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="badge bg-secondary fs-6">Puntos acumulados: @puntosTotales</span>
            @if (!minijuegoActivo)
            {
                <button class="btn btn-primary px-4 fw-bold" @onclick="IniciarOscilacion">Comenzar Tiro</button>
            }
            else
            {
                <button class="btn btn-warning px-4 fw-bold" @onclick="DetenerTiro">¡LANZAR!</button>
            }
        </div>
        <p class="mt-3 text-info fw-semibold">@mensajeTiro</p>
    }
    else if (etapaMinijuego == 2)
    {
        <!-- MINIJUEGO 2: REACCIÓN DE PASE -->
        <h5 class="fw-bold">Prueba 2: Visión y Pase Rápido</h5>
        <p class="small text-muted">Espera a que el objetivo cambie a color VERDE y presiona de inmediato.</p>

        <div class="my-4 py-5 rounded text-white fw-bold fs-4 d-flex align-items-center justify-content-center"
             style="background-color: @colorReaccion; min-height: 140px; cursor: pointer; user-select: none;"
             @onclick="ManejarClickReaccion">
            @textoReaccion
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <span class="badge bg-secondary fs-6">Puntos acumulados: @puntosTotales</span>
            @if (!esperandoReaccion && !reaccionLista)
            {
                <button class="btn btn-primary px-4 fw-bold" @onclick="IniciarPruebaReaccion">Iniciar Prueba</button>
            }
        </div>
        <p class="mt-3 text-info fw-semibold">@mensajeReaccion</p>
    }
</div>

@code {
    private int etapaMinijuego = 1;
    private int puntosTotales = 0;

    // Variables Minijuego 1: Tiro
    private int posicionBarra = 0;
    private bool direccionDerecha = true;
    private bool minijuegoActivo = false;
    private int tirosRealizados = 0;
    private string mensajeTiro = "Presiona 'Comenzar Tiro' para iniciar.";
    private CancellationTokenSource? ctsTiro;

    // Variables Minijuego 2: Reacción
    private string colorReaccion = "#6c757d";
    private string textoReaccion = "Presiona Iniciar Prueba";
    private bool esperandoReaccion = false;
    private bool reaccionLista = false;
    private DateTime momentoVerde;
    private string mensajeReaccion = "";
    private CancellationTokenSource? ctsReaccion;

    private async Task IniciarOscilacion()
    {
        minijuegoActivo = true;
        mensajeTiro = "¡Calcula el timing!";
        ctsTiro = new CancellationTokenSource();

        while (minijuegoActivo && !ctsTiro.Token.IsCancellationRequested)
        {
            if (direccionDerecha)
            {
                posicionBarra += 3;
                if (posicionBarra >= 96) direccionDerecha = false;
            }
            else
            {
                posicionBarra -= 3;
                if (posicionBarra <= 2) direccionDerecha = true;
            }

            StateHasChanged();
            await Task.Delay(16);
        }
    }

    private void DetenerTiro()
    {
        minijuegoActivo = false;
        ctsTiro?.Cancel();
        tirosRealizados++;

        if (posicionBarra >= 70 && posicionBarra <= 85)
        {
            puntosTotales += 25;
            mensajeTiro = $"¡TIRO PERFECTO! (+25 pts) - Barra en {posicionBarra}%";
        }
        else if (posicionBarra >= 60 && posicionBarra <= 92)
        {
            puntosTotales += 10;
            mensajeTiro = $"¡Aro y adentro! (+10 pts) - Barra en {posicionBarra}%";
        }
        else
        {
            mensajeTiro = $"¡Fallaste el tiro! (0 pts) - Barra en {posicionBarra}%";
        }

        if (tirosRealizados >= 3)
        {
            Task.Run(async () =>
            {
                await Task.Delay(1500);
                etapaMinijuego = 2;
                await InvokeAsync(StateHasChanged);
            });
        }
    }

    private async Task IniciarPruebaReaccion()
    {
        esperandoReaccion = true;
        reaccionLista = false;
        colorReaccion = "#dc3545";
        textoReaccion = "¡PREPÁRATE...";
        mensajeReaccion = "No presiones hasta que cambie a verde.";
        StateHasChanged();

        ctsReaccion = new CancellationTokenSource();
        int esperaMs = Random.Shared.Next(2000, 4500);

        try
        {
            await Task.Delay(esperaMs, ctsReaccion.Token);
            colorReaccion = "#198754";
            textoReaccion = "¡PASA EL BALÓN AHORA!";
            momentoVerde = DateTime.UtcNow;
            reaccionLista = true;
            esperandoReaccion = false;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private void ManejarClickReaccion()
    {
        if (esperandoReaccion)
        {
            ctsReaccion?.Cancel();
            esperandoReaccion = false;
            colorReaccion = "#6c757d";
            textoReaccion = "¡FALTA! Saliste antes.";
            mensajeReaccion = "Penalización por anticiparte (0 pts).";
            FinalizarDraft();
        }
        else if (reaccionLista)
        {
            reaccionLista = false;
            var ms = (int)(DateTime.UtcNow - momentoVerde).TotalMilliseconds;

            if (ms < 300)
            {
                puntosTotales += 30;
                mensajeReaccion = $"¡Reflejos de élite! {ms} ms (+30 pts)";
            }
            else if (ms < 500)
            {
                puntosTotales += 15;
                mensajeReaccion = $"Buen tiempo de respuesta: {ms} ms (+15 pts)";
            }
            else
            {
                puntosTotales += 5;
                mensajeReaccion = $"Pase lento: {ms} ms (+5 pts)";
            }

            colorReaccion = "#0d6efd";
            textoReaccion = "¡Pruebas terminadas!";
            StateHasChanged();

            FinalizarDraft();
        }
    }

    private void FinalizarDraft()
    {
        Task.Run(async () =>
        {
            await Task.Delay(1800);
            await InvokeAsync(() => GameState.FinalizarCombine(puntosTotales));
        });
    }

    public void Dispose()
    {
        ctsTiro?.Cancel();
        ctsReaccion?.Cancel();
    }
}
