@namespace TheNextPick.Components
@using TheNextPick.Engine
@inject GameStateService GameState

<div class="sports-card p-4 text-center" style="max-width: 620px; margin: auto;">
    <div class="mb-3">
        <img src="https://a.espncdn.com/i/teamlogos/leagues/500/nba.png" style="height: 60px;" alt="NBA" />
        <h2 class="nba-title text-white mt-2 mb-0">NBA DRAFT COMBINE</h2>
        <span class="text-secondary small">Evaluación de Prospección Oficial (Prueba @(pruebaActual)/2)</span>
    </div>

    <MinijuegoArena TipoActual="@tipoPruebaActual" AlCompletar="ManejarPruebaCompletada" />
</div>

@code {
    private int pruebaActual = 1;
    private int puntosAcumulados = 0;
    private MinijuegoArena.TipoMinijuego tipoPruebaActual;

    private readonly MinijuegoArena.TipoMinijuego[] pruebasDisponibles = new[]
    {
        MinijuegoArena.TipoMinijuego.TiroSuspension,
        MinijuegoArena.TipoMinijuego.SaltoVertical,
        MinijuegoArena.TipoMinijuego.DribbleQTE
    };

    protected override void OnInitialized()
    {
        tipoPruebaActual = pruebasDisponibles[Random.Shared.Next(pruebasDisponibles.Length)];
    }

    private void ManejarPruebaCompletada(int pts)
    {
        puntosAcumulados += pts;
        if (pruebaActual == 1)
        {
            pruebaActual = 2;
            tipoPruebaActual = pruebasDisponibles.First(p => p != tipoPruebaActual);
            StateHasChanged();
        }
        else
        {
            GameState.FinalizarCombine(puntosAcumulados);
        }
    }
}
