@namespace TheNextPick.Components
@implements IDisposable

<div class="sports-card p-3 my-3 text-center" style="max-width: 580px; margin: auto; background: #0c1017; border: 2px solid #2d3748;">
    <div class="d-flex justify-content-between align-items-center mb-2 px-2">
        <span class="badge bg-danger text-uppercase px-2 py-1 small fw-bold">PRUEBA 2/5: SPRINT 3/4 CANCHA</span>
        <span class="text-white small fw-bold">TIEMPO: @tiempoTranscurrido.ToString("0.00")s (@puntos / 20 PTS)</span>
    </div>

    <div class="position-relative mx-auto rounded overflow-hidden" style="width: 100%; height: 230px; border: 2px solid #2d3748;">
        <CanchaFondo />

        <!-- Línea de Meta -->
        <svg viewBox="0 0 40 230" class="position-absolute end-0 top-0 h-100" style="width: 40px; pointer-events: none; z-index: 5;">
            <line x1="20" y1="0" x2="20" y2="230" stroke="#f59e0b" stroke-width="5" stroke-dasharray="8" />
            <text x="5" y="115" fill="#f59e0b" font-size="11" font-weight="bold" transform="rotate(-90 15,115)">META</text>
        </svg>

        <!-- Corredor Pixel Art -->
        <div class="position-absolute" style="left: @(20 + (progresoSprint * 4.4))px; bottom: 15px; transition: left 0.06s linear; z-index: 6;">
            <PixelArtPlayer Estado="@(finalizado ? "Celebrando" : (activo ? "Bote" : "Idle"))" TieneBalon="false" ColorPrimario="#1D428A" AnchoPx="85" AltoPx="110" />
        </div>

        <div class="position-absolute bottom-0 start-0 w-100 bg-dark progress" style="height: 6px; z-index: 10;">
            <div class="progress-bar bg-warning" style="width: @progresoSprint%;"></div>
        </div>
    </div>

    @if (!activo && !finalizado)
    {
        <button class="btn btn-warning py-3 px-5 fw-bold text-dark fs-5 mt-3 w-100" @onclick="IniciarSprint">
            ALINEARSE EN LÍNEA DE SALIDA (CRONÓMETRO ACTIVO) ⏱️
        </button>
    }
    else if (activo)
    {
        <div class="d-flex justify-content-center gap-3 mt-3">
            <button class="btn @(pieEsperado == 0 ? "btn-warning text-dark scale-tap" : "btn-outline-secondary text-muted") py-3 px-4 fw-bold fs-5 flex-grow-1" 
                    @onclick="() => Pisar(0)">
                PIE IZQ 👟
            </button>
            <button class="btn @(pieEsperado == 1 ? "btn-warning text-dark scale-tap" : "btn-outline-secondary text-muted") py-3 px-4 fw-bold fs-5 flex-grow-1" 
                    @onclick="() => Pisar(1)">
                PIE DER 👟
            </button>
        </div>
    }

    <div class="mt-2 text-info fw-semibold small">@mensajeGuia</div>
</div>

@code {
    [Parameter] public EventCallback<int> OnFinalizado { get; set; }

    private double progresoSprint = 0;
    private int pieEsperado = 0;
    private bool activo = false;
    private bool finalizado = false;
    private DateTime inicioTiempo;
    private double tiempoTranscurrido = 0;
    private int puntos = 0;
    private string mensajeGuia = "Alterna los botones con rapidez rítmica. Cada segundo de retraso te costará posiciones en el Draft.";
    private CancellationTokenSource cts = new();

    private async Task IniciarSprint()
    {
        activo = true;
        progresoSprint = 0;
        pieEsperado = 0;
        inicioTiempo = DateTime.UtcNow;

        _ = Task.Run(async () =>
        {
            while (activo && !cts.Token.IsCancellationRequested)
            {
                tiempoTranscurrido = (DateTime.UtcNow - inicioTiempo).TotalSeconds;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(40, cts.Token);
            }
        });
    }

    private async void Pisar(int pie)
    {
        if (!activo || finalizado) return;

        if (pie == pieEsperado)
        {
            progresoSprint = Math.Min(100, progresoSprint + 7.5);
            pieEsperado = (pieEsperado == 0) ? 1 : 0;
            StateHasChanged();

            if (progresoSprint >= 100)
            {
                finalizado = true;
                activo = false;
                cts.Cancel();
                tiempoTranscurrido = (DateTime.UtcNow - inicioTiempo).TotalSeconds;

                // Penalización estricta por tiempo
                if (tiempoTranscurrido <= 3.15) puntos = 20; // Récord NBA Combine
                else if (tiempoTranscurrido <= 3.45) puntos = 15;
                else if (tiempoTranscurrido <= 3.85) puntos = 9;
                else if (tiempoTranscurrido <= 4.40) puntos = 4;
                else puntos = 1; // Demora crítica

                mensajeGuia = $"¡Tiempo final: {tiempoTranscurrido.ToString("0.00")}s! (+{puntos} PTS).";
                StateHasChanged();

                await Task.Delay(1300);
                await OnFinalizado.InvokeAsync(puntos);
            }
        }
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}
