@namespace TheNextPick.Components

<div class="player-sprite-unit @ClaseEstado" style="width: @(AnchoPx)px; height: @(AltoPx)px; display: inline-block; position: relative; user-select: none;">
    <svg viewBox="0 0 48 56" width="100%" height="100%" style="shape-rendering: crispEdges; overflow: visible;">
        
        <!-- SOMBRA DINÁMICA -->
        <ellipse cx="24" cy="53" 
                 rx="@(Estado == "Saltando" ? 7 : 14)" 
                 ry="@(Estado == "Saltando" ? 2 : 3.5)" 
                 fill="rgba(0,0,0,@(Estado == "Saltando" ? 0.2 : 0.45))" />

        <!-- CUERPO COMPLETO -->
        <g transform="@(Estado == "Saltando" ? "translate(0, -12)" : "translate(0, 0)")">
            
            <!-- CABELLO ANIME (VOLUMEN SUPERIOR) -->
            <path d="M 14,4 L 34,4 L 38,8 L 40,16 L 36,15 L 34,18 L 30,17 L 28,20 L 20,19 L 18,21 L 14,17 L 11,14 L 10,8 Z" 
                  fill="#18110b" stroke="#000" stroke-width="1.5" />
            <path d="M 16,6 L 32,6 L 35,9 L 31,12 L 24,12 L 21,15 L 16,12 Z" fill="#311f14" />

            <!-- VINCHA DEPORTIVA AMARILLA -->
            <rect x="14" y="11" width="20" height="3" fill="#FFC72C" stroke="#000" stroke-width="1" />

            <!-- ROSTRO Y PIEL -->
            <rect x="14" y="14" width="20" height="11" fill="#f5c492" stroke="#000" stroke-width="1.5" />

            <!-- OJOS SEGÚN ESTADO -->
            @if (Estado == "Celebrando")
            {
                <path d="M 17,18 L 21,16 L 17,17" stroke="#000" stroke-width="2" fill="none" />
                <path d="M 27,18 L 31,16 L 27,17" stroke="#000" stroke-width="2" fill="none" />
                <rect x="22" y="21" width="4" height="2" fill="#c2410c" />
            }
            else
            {
                <rect x="18" y="17" width="4" height="5" fill="#000" />
                <rect x="19" y="18" width="1.5" height="1.5" fill="#fff" />
                <rect x="26" y="17" width="4" height="5" fill="#000" />
                <rect x="27" y="18" width="1.5" height="1.5" fill="#fff" />
                <rect x="17" y="16" width="5" height="1" fill="#000" />
                <rect x="26" y="16" width="5" height="1" fill="#000" />
                <rect x="22" y="22" width="4" height="1" fill="#000" />
            }

            <!-- CAMISETA CON DORSAL DINÁMICO -->
            <rect x="14" y="25" width="20" height="14" fill="@ColorPrimario" stroke="#000" stroke-width="1.5" />
            <rect x="14" y="25" width="2.5" height="14" fill="#FFC72C" />
            <rect x="31.5" y="25" width="2.5" height="14" fill="#FFC72C" />
            
            <!-- DORSAL REACTIVO DEL JUGADOR -->
            <text x="24" y="34.5" text-anchor="middle"
                  font-family="'Courier New', monospace, sans-serif"
                  font-size="7.5" font-weight="900"
                  fill="#FFC72C" stroke="#000" stroke-width="0.6"
                  style="user-select: none;">
                @NumeroDorsal
            </text>

            <!-- PANTALONES CORTOS -->
            <rect x="14" y="38" width="20" height="6" fill="@ColorPrimario" stroke="#000" stroke-width="1.5" />
            <rect x="23" y="40" width="2" height="4" fill="#000" />
            <line x1="14" y1="43" x2="34" y2="43" stroke="#FFC72C" stroke-width="1" />

            <!-- EXTREMIDADES SEGÚN ESTADO -->
            @if (Estado == "Defendiendo")
            {
                <rect x="6" y="27" width="8" height="5" rx="1.5" fill="#f5c492" stroke="#000" stroke-width="1.2" />
                <rect x="34" y="27" width="8" height="5" rx="1.5" fill="#f5c492" stroke="#000" stroke-width="1.2" />
                <rect x="13" y="44" width="5" height="6" fill="#f5c492" stroke="#000" stroke-width="1" />
                <rect x="30" y="44" width="5" height="6" fill="#f5c492" stroke="#000" stroke-width="1" />
                <rect x="8" y="48" width="11" height="5" fill="#ffffff" stroke="#000" stroke-width="1.5" />
                <rect x="8" y="51" width="11" height="2" fill="#FFC72C" />
                <rect x="29" y="48" width="11" height="5" fill="#ffffff" stroke="#000" stroke-width="1.5" />
                <rect x="29" y="51" width="11" height="2" fill="#FFC72C" />
            }
            else if (Estado == "Saltando")
            {
                <rect x="11" y="14" width="4" height="12" rx="1.5" fill="#f5c492" stroke="#000" stroke-width="1.2" />
                <rect x="33" y="14" width="4" height="12" rx="1.5" fill="#f5c492" stroke="#000" stroke-width="1.2" />
                <rect x="17" y="44" width="4.5" height="7" fill="#f5c492" stroke="#000" stroke-width="1" />
                <rect x="26" y="44" width="4.5" height="7" fill="#f5c492" stroke="#000" stroke-width="1" />
                <rect x="14" y="49" width="9" height="5" fill="#ffffff" stroke="#000" stroke-width="1.5" />
                <rect x="14" y="52" width="9" height="2" fill="#FFC72C" />
                <rect x="25" y="49" width="9" height="5" fill="#ffffff" stroke="#000" stroke-width="1.5" />
                <rect x="25" y="52" width="9" height="2" fill="#FFC72C" />

                @if (TieneBalon)
                {
                    <circle cx="31" cy="9" r="7" fill="#e65100" stroke="#000" stroke-width="1.5" />
                    <line x1="24" y1="9" x2="38" y2="9" stroke="#000" stroke-width="1" />
                    <line x1="31" y1="2" x2="31" y2="16" stroke="#000" stroke-width="1" />
                }
            }
            else if (Estado == "Celebrando")
            {
                <rect x="9" y="15" width="5" height="11" rx="1.5" fill="#f5c492" stroke="#000" stroke-width="1.2" />
                <rect x="34" y="15" width="5" height="11" rx="1.5" fill="#f5c492" stroke="#000" stroke-width="1.2" />
                <rect x="17" y="44" width="4.5" height="6" fill="#f5c492" stroke="#000" stroke-width="1" />
                <rect x="26" y="44" width="4.5" height="6" fill="#f5c492" stroke="#000" stroke-width="1" />
                <rect x="13" y="48" width="10" height="5" fill="#ffffff" stroke="#000" stroke-width="1.5" />
                <rect x="13" y="51" width="10" height="2" fill="#FFC72C" />
                <rect x="25" y="48" width="10" height="5" fill="#ffffff" stroke="#000" stroke-width="1.5" />
                <rect x="25" y="51" width="10" height="2" fill="#FFC72C" />
            }
            else
            {
                <rect x="9" y="25" width="5" height="10" rx="1.5" fill="#f5c492" stroke="#000" stroke-width="1.2" />
                
                @if (TieneBalon)
                {
                    <rect x="34" y="26" width="5" height="9" rx="1.5" fill="#f5c492" stroke="#000" stroke-width="1.2" />
                    <rect x="34" y="31" width="5" height="2.5" fill="#FFC72C" />
                    
                    <g class="arcade-ball-bounce">
                        <circle cx="39" cy="42" r="6.5" fill="#e65100" stroke="#000" stroke-width="1.5" />
                        <line x1="32.5" y1="42" x2="45.5" y2="42" stroke="#000" stroke-width="1" />
                        <line x1="39" y1="35.5" x2="39" y2="48.5" stroke="#000" stroke-width="1" />
                    </g>
                }
                else
                {
                    <rect x="34" y="25" width="5" height="10" rx="1.5" fill="#f5c492" stroke="#000" stroke-width="1.2" />
                }

                <rect x="17" y="44" width="4.5" height="6" fill="#f5c492" stroke="#000" stroke-width="1" />
                <rect x="26" y="44" width="4.5" height="6" fill="#f5c492" stroke="#000" stroke-width="1" />
                <rect x="13" y="48" width="10" height="5" fill="#ffffff" stroke="#000" stroke-width="1.5" />
                <rect x="13" y="51" width="10" height="2" fill="#FFC72C" />
                <rect x="25" y="48" width="10" height="5" fill="#ffffff" stroke="#000" stroke-width="1.5" />
                <rect x="25" y="51" width="10" height="2" fill="#FFC72C" />
            }
        </g>
    </svg>
</div>

<style>
    .player-sprite-unit {
        transition: transform 0.15s ease-out;
    }
    .arcade-ball-bounce {
        animation: anim-snap-ball 0.4s infinite alternate ease-in;
    }
    @@keyframes anim-snap-ball {
        0% { transform: translateY(-10px); }
        100% { transform: translateY(2px) scale(1.08, 0.92); }
    }
</style>

@code {
    [Parameter] public string Estado { get; set; } = "Bote";
    [Parameter] public bool TieneBalon { get; set; } = true;
    [Parameter] public string ColorPrimario { get; set; } = "#1D428A";
    [Parameter] public int NumeroDorsal { get; set; } = 11;
    [Parameter] public int AnchoPx { get; set; } = 100;
    [Parameter] public int AltoPx { get; set; } = 120;

    private string ClaseEstado => Estado.ToLower();
}
