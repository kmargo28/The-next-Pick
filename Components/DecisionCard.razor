@namespace TheNextPick.Components
@using TheNextPick.Models
@using TheNextPick.Engine
@inject GameStateService GameState

@if (GameState.DilemaActual != null)
{
    <div class="card shadow-lg border-0 my-3" style="border-radius: 16px; overflow: hidden;">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2 px-3">
            <span class="badge bg-warning text-dark fw-bold">@GameState.DilemaActual.Categoria</span>
            <small class="text-secondary fw-semibold">Temporada @GameState.TemporadaActual</small>
        </div>

        <div class="card-body p-4 text-center">
            <h4 class="fw-bold mb-3 text-dark">@GameState.DilemaActual.Titulo</h4>
            <p class="text-muted fs-6 mb-4" style="line-height: 1.6;">
                @GameState.DilemaActual.Descripcion
            </p>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <button class="btn btn-outline-primary w-100 p-3 fw-semibold text-wrap shadow-sm h-100"
                            @onclick="() => Elegir(GameState.DilemaActual.OpcionA)">
                        👈 @GameState.DilemaActual.OpcionA.Texto
                    </button>
                </div>
                <div class="col-12 col-md-6">
                    <button class="btn btn-outline-dark w-100 p-3 fw-semibold text-wrap shadow-sm h-100"
                            @onclick="() => Elegir(GameState.DilemaActual.OpcionB)">
                        👉 @GameState.DilemaActual.OpcionB.Texto
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private void Elegir(OpcionDilema opcion)
    {
        GameState.TomarOpcion(opcion);
    }
}
