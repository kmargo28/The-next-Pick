@namespace TheNextPick.Components
@using TheNextPick.Models
@using TheNextPick.Engine
@inject GameStateService GameState

@if (GameState.DilemaActual != null)
{
    <div class="my-4 text-start">
        <h4 class="text-white fw-bold mb-1">@GameState.DilemaActual.Titulo</h4>
        <p class="text-secondary small mb-3">@GameState.DilemaActual.Descripcion</p>

        <div class="row g-3">
            <!-- OPCIÓN A -->
            <div class="col-12 col-md-6">
                <div class="sports-card p-3 h-100 d-flex flex-column justify-content-between" style="background: #181d26; border-radius: 14px;">
                    <div class="text-center mb-2">
                        <span class="fw-bold text-light">@GameState.DilemaActual.OpcionA.Texto</span>
                    </div>

                    @if (!string.IsNullOrEmpty(GameState.DilemaActual.OpcionA.ImagenUrl))
                    {
                        <div class="rounded mb-3 overflow-hidden" style="height: 180px; border: 1px solid rgba(255,255,255,0.1);">
                            <img src="@GameState.DilemaActual.OpcionA.ImagenUrl" 
                                 style="width: 100%; height: 100%; object-fit: cover;" 
                                 alt="@GameState.DilemaActual.OpcionA.Texto" />
                        </div>
                    }

                    <button class="btn btn-choice w-100 py-2 fw-semibold" 
                            @onclick="() => GameState.TomarOpcion(GameState.DilemaActual.OpcionA)">
                        Elegir esta opcion
                    </button>
                </div>
            </div>

            <!-- OPCIÓN B -->
            <div class="col-12 col-md-6">
                <div class="sports-card p-3 h-100 d-flex flex-column justify-content-between" style="background: #181d26; border-radius: 14px;">
                    <div class="text-center mb-2">
                        <span class="fw-bold text-light">@GameState.DilemaActual.OpcionB.Texto</span>
                    </div>

                    @if (!string.IsNullOrEmpty(GameState.DilemaActual.OpcionB.ImagenUrl))
                    {
                        <div class="rounded mb-3 overflow-hidden" style="height: 180px; border: 1px solid rgba(255,255,255,0.1);">
                            <img src="@GameState.DilemaActual.OpcionB.ImagenUrl" 
                                 style="width: 100%; height: 100%; object-fit: cover;" 
                                 alt="@GameState.DilemaActual.OpcionB.Texto" />
                        </div>
                    }

                    <button class="btn btn-choice w-100 py-2 fw-semibold" 
                            @onclick="() => GameState.TomarOpcion(GameState.DilemaActual.OpcionB)">
                        Elegir esta opcion
                    </button>
                </div>
            </div>
        </div>
    </div>
}
