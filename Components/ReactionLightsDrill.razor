@namespace TheNextPick.Components
@implements IDisposable

<div class="sports-card p-3 my-3 text-center" style="max-width: 580px; margin: auto; background: #0c1017; border: 2px solid #2d3748;">
    <div class="d-flex justify-content-between align-items-center mb-2 px-2">
        <span class="badge bg-info text-dark text-uppercase px-2 py-1 small fw-bold">PRUEBA 4/5: LUCES DE REACCIÓN</span>
        <span class="text-white small fw-bold">ACIERTOS: @aciertos / 10 | ERRORES: @errores</span>
    </div>

    <!-- PANEL DE 6 SENSORES DE REFLEJOS -->
    <div class="p-4 my-2 rounded bg-black border border-secondary">
        <div class="row g-3">
            @for (int s = 0; s < 6; s++)
            {
                var sensorId = s;
                var estaEncendido = (sensorId == sensorActivo && luzEncendida);
                <div class="col-4">
                    <button class="btn w-100 py-4 rounded-circle border border-2 sensor-btn @(estaEncendido ? "sensor-on" : "sensor-off")"
                            @onclick="() => PulsarSensor(sensorId)" disabled="@(!activo)">
                        @(estaEncendido ? "⚡" : "•")
                    </button>
                </div>
            }
        </div>
    </div>

    @if (!activo && !finalizado)
    {
        <button class="btn btn-warning py-3 px-5 fw-bold text-dark fs-5 mt-2 w-100" @onclick="IniciarPrueba">
            ACTIVAR SENSORES DE REFLEJOS ⏱️
        </button>
    }

    <div class="mt-2 text-info fw-semibold small">@mensajeGuia</div>
</div>

<style>
    .sensor-btn { font-size: 24px; height: 75px; transition: all 0.08s; }
    .sensor-on { background: #00e676 !important; border-color: #fff !important; box-shadow: 0 0 20px #00e676; }
    .sensor-off { background: #1f2937 !important; border-color: #374151 !important; color: #4b5563; }
</style>

@code {
    [Parameter] public EventCallback<int> OnFinalizado { get; set; }

    private int aciertos = 0;
    private int errores = 0;
    private int sensorActivo = -1;
    private bool luzEncendida = false;
    private bool activo = false;
    private bool finalizado = false;
    private string mensajeGuia = "Pulsa el sensor que se ilumine en verde antes de que se apague.";
    private CancellationTokenSource cts = new();

    private async Task IniciarPrueba()
    {
        activo = true;
        aciertos = 0;
        errores = 0;

        for (int r = 0; r < 10; r++)
        {
            if (!activo) break;
            sensorActivo = Random.Shared.Next(0, 6);
            luzEncendida = true;
            StateHasChanged();

            // Tiempo límite para tocar la luz (850ms)
            await Task.Delay(850, cts.Token);

            if (luzEncendida) // Si sigue encendida es que no la tocó a tiempo
            {
                errores++;
                luzEncendida = false;
                StateHasChanged();
            }

            await Task.Delay(300, cts.Token);
        }

        finalizado = true;
        activo = false;

        // Puntuación estricta
        int puntos = Math.Clamp((aciertos * 2) - (errores * 2), 0, 20);
        mensajeGuia = $"Prueba concluida: {aciertos} aciertos y {errores} fallos (+{puntos} PTS).";
        StateHasChanged();

        await Task.Delay(1300);
        await OnFinalizado.InvokeAsync(puntos);
    }

    private void PulsarSensor(int id)
    {
        if (!activo || !luzEncendida) return;

        if (id == sensorActivo)
        {
            aciertos++;
            luzEncendida = false;
        }
        else
        {
            errores++;
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}
