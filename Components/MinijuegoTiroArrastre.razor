@namespace TheNextPick.Components
@using TheNextPick.Engine
@using TheNextPick.Models
@inject GameStateService GameState
@implements IDisposable

<div class="sports-card p-3 my-3 text-center position-relative" style="max-width: 640px; margin: auto; background: #0c1017; border: 3px solid #000; box-shadow: 0 10px 30px rgba(0,0,0,0.8);">
    
    <div class="d-flex justify-content-between align-items-center mb-2 px-2">
        <span class="badge bg-warning text-dark text-uppercase px-3 py-1 fs-6 fw-bold border border-dark">🏀 TIRO DE ARRASTRE ARCADE</span>
        <span class="text-white fw-bold fs-5">CANASTAS: @canastas / @intentosMax (Intento @(Math.Min(intentoActual, intentosMax))/@intentosMax)</span>
    </div>

    <!-- PISTA DE JUEGO -->
    <div class="position-relative mx-auto rounded overflow-hidden" 
         style="width: 100%; height: 300px; border: 3px solid #000; background: #111; touch-action: none;">
        
        <CanchaFondo />

        <!-- CANASTA A LA DERECHA -->
        <svg viewBox="0 0 140 180" class="position-absolute end-0" style="width: 130px; height: 170px; top: 40px; pointer-events: none; z-index: 5;">
            <line x1="110" y1="10" x2="110" y2="160" stroke="#000" stroke-width="8" />
            <line x1="110" y1="10" x2="110" y2="160" stroke="#cbd5e1" stroke-width="4" />
            <rect x="95" y="15" width="8" height="60" fill="#fff" stroke="#000" stroke-width="2" />
            <rect x="97" y="32" width="4" height="26" fill="none" stroke="#e11d48" stroke-width="2" />

            <line x1="58" y1="52" x2="95" y2="52" stroke="#ff4500" stroke-width="5" stroke-linecap="round" />
            
            <g class="@(netSwish ? "red-swish-anim" : "")">
                <path d="M 60,54 L 64,80 L 88,80 L 92,54 Z" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-dasharray="3" />
                <line x1="64" y1="80" x2="68" y2="92" stroke="#fff" stroke-width="2" />
                <line x1="88" y1="80" x2="84" y2="92" stroke="#fff" stroke-width="2" />
            </g>

            <ellipse cx="76" cy="52" rx="16" ry="3.5" fill="none" stroke="#000" stroke-width="3" />
            <ellipse cx="76" cy="52" rx="15" ry="3" fill="none" stroke="#ff4500" stroke-width="2" />
        </svg>

        <!-- DEFENSOR: SIN BALÓN Y CON BRAZOS EN MARCA -->
        <div class="position-absolute" style="right: 170px; bottom: 20px; transform: scaleX(-1); pointer-events: none; z-index: 6;">
            <PixelArtPlayer Estado="@(volando ? "Saltando" : "Defendiendo")" TieneBalon="false" ColorPrimario="#475569" AnchoPx="100" AltoPx="120" />
        </div>

        <!-- ATACANTE: TU JUGADOR -->
        <div class="position-absolute" style="left: 60px; bottom: 20px; pointer-events: none; z-index: 6;">
            <PixelArtPlayer Estado="@estadoJugador" TieneBalon="@(!volando)" ColorPrimario="@colorEquipo" AnchoPx="105" AltoPx="125" />
        </div>

        <!-- TRAYECTORIA EN PARÁBOLA PROYECTADA -->
        @if (arrastrando)
        {
            <svg viewBox="0 0 600 300" class="position-absolute top-0 start-0 w-100 h-100" style="pointer-events: none; z-index: 10;">
                <line x1="110" y1="180" x2="@cursorX" y2="@cursorY" stroke="#fbbf24" stroke-width="3" stroke-dasharray="4" />
                @for (int p = 1; p <= 8; p++)
                {
                    double t = p * 0.12;
                    double dotX = 110 + (velocidadX * t * 14);
                    double dotY = 180 - (velocidadY * t * 11 - 0.5 * 32 * t * t);
                    <circle cx="@dotX" cy="@dotY" r="@(5.5 - (p * 0.4))" fill="#f59e0b" stroke="#000" stroke-width="1.5" />
                }
            </svg>
        }

        <!-- BALÓN VOLANDO EN PARÁBOLA -->
        @if (volando)
        {
            <div class="position-absolute" style="left: @(balonX)px; top: @(balonY)px; transform: translate(-50%, -50%); pointer-events: none; z-index: 15;">
                <svg width="28" height="28" viewBox="0 0 28 28" class="balon-volando-giro">
                    <circle cx="14" cy="14" r="12" fill="#e65100" stroke="#000" stroke-width="2.5" />
                    <line x1="2" y1="14" x2="26" y2="14" stroke="#000" stroke-width="2" />
                    <line x1="14" y1="2" x2="14" y2="26" stroke="#000" stroke-width="2" />
                </svg>
            </div>
        }

        <!-- POPUP ARCADE -->
        @if (!string.IsNullOrEmpty(textoArcadePop))
        {
            <div class="position-absolute top-50 start-50 translate-middle text-center arcade-pop-anim" style="pointer-events: none; z-index: 25;">
                <span class="display-3 fw-bold @colorTextoPop nba-title" style="-webkit-text-stroke: 2px #000; text-shadow: 4px 4px 0 #000;">
                    @textoArcadePop
                </span>
            </div>
        }

        <!-- CAPA TRANSPARENTE DE ARRASTRE -->
        <div class="position-absolute top-0 start-0 w-100 h-100" 
             style="cursor: @(volando ? "default" : (arrastrando ? "grabbing" : "grab")); z-index: 20;"
             @onpointerdown="IniciarArrastre"
             @onpointermove="MoverArrastre"
             @onpointerup="FinalizarTiro">
        </div>
    </div>

    <div class="mt-2 text-warning small fw-bold">
        🎯 Haz clic sobre la cancha, arrastra hacia abajo e izquierda para elevar la comba y suelta para lanzar.
    </div>
</div>

<style>
    .balon-volando-giro {
        animation: anim-rotacion 0.3s infinite linear;
    }
    @@keyframes anim-rotacion {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .arcade-pop-anim {
        animation: anim-pop 0.8s forwards cubic-bezier(0.18, 0.89, 0.32, 1.28);
    }
    @@keyframes anim-pop {
        0% { transform: translate(-50%, -50%) scale(0.3); opacity: 0; }
        60% { transform: translate(-50%, -50%) scale(1.2); opacity: 1; }
        100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    }

    .red-swish-anim {
        animation: anim-swish 0.35s ease-out;
        transform-origin: 76px 54px;
    }
    @@keyframes anim-swish {
        0% { transform: scale(1, 1); }
        50% { transform: scale(1.3, 1.4) skewX(8deg); }
        100% { transform: scale(1, 1); }
    }
</style>

@code {
    [Parameter] public EventCallback<bool> OnFinalizado { get; set; }

    private string estadoJugador = "Bote";
    private string colorEquipo = "#1D428A";
    private bool arrastrando = false;
    private bool volando = false;
    private bool netSwish = false;

    private double startPointerX;
    private double startPointerY;
    private double cursorX = 110;
    private double cursorY = 180;
    private double velocidadX = 20;
    private double velocidadY = 24;

    private double balonX = 110;
    private double balonY = 180;

    private int canastas = 0;
    private int intentoActual = 1;
    private const int intentosMax = 3;

    private string textoArcadePop = "";
    private string colorTextoPop = "text-warning";
    private CancellationTokenSource cts = new();

    protected override void OnInitialized()
    {
        var eq = EquipoNBA.ObtenerPorNombre(GameState.JugadorActivo?.EquipoActual ?? "");
        colorEquipo = eq.ColorPrimario;
    }

    private void IniciarArrastre(PointerEventArgs e)
    {
        if (volando || intentoActual > intentosMax) return;
        arrastrando = true;
        startPointerX = e.ClientX;
        startPointerY = e.ClientY;
        cursorX = 110;
        cursorY = 180;
        velocidadX = 18;
        velocidadY = 22;
        estadoJugador = "PreparandoTiro";
        textoArcadePop = "";
    }

    private void MoverArrastre(PointerEventArgs e)
    {
        if (!arrastrando || volando) return;

        double dx = (startPointerX - e.ClientX) * 0.45;
        double dy = (e.ClientY - startPointerY) * 0.45;

        cursorX = 110 - dx;
        cursorY = 180 + dy;

        velocidadX = Math.Clamp(15 + dx, 10, 36);
        velocidadY = Math.Clamp(18 + dy, 12, 42);
        StateHasChanged();
    }

    private async Task FinalizarTiro(PointerEventArgs e)
    {
        if (!arrastrando || volando) return;
        arrastrando = false;
        volando = true;
        estadoJugador = "Lanzando";

        balonX = 110;
        balonY = 180;
        double vx = velocidadX;
        double vy = -velocidadY;
        double gravedad = 1.35;

        for (int i = 0; i < 32; i++)
        {
            balonX += vx * 0.58;
            balonY += vy * 0.58;
            vy += gravedad;

            if (balonX >= 485 && balonX <= 545 && balonY >= 70 && balonY <= 112)
            {
                break;
            }

            StateHasChanged();
            await Task.Delay(16);
        }

        bool esCanasta = (balonX >= 495 && balonX <= 540 && balonY >= 72 && balonY <= 112);

        if (esCanasta)
        {
            canastas++;
            netSwish = true;
            estadoJugador = "Celebrando";
            textoArcadePop = "SWISH!! 🎯";
            colorTextoPop = "text-success";
            StateHasChanged();
            await Task.Delay(280);
            netSwish = false;
        }
        else
        {
            estadoJugador = "Bote";
            textoArcadePop = "CLANK! ❌";
            colorTextoPop = "text-danger";
            for (int r = 0; r < 6; r++)
            {
                balonX -= 3;
                balonY += 6;
                StateHasChanged();
                await Task.Delay(18);
            }
        }

        await Task.Delay(800);
        volando = false;
        textoArcadePop = "";

        if (intentoActual >= intentosMax)
        {
            await OnFinalizado.InvokeAsync(canastas >= 2);
        }
        else
        {
            intentoActual++;
            estadoJugador = "Bote";
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}
