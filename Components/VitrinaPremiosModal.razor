@namespace TheNextPick.Components
@using TheNextPick.Models
@using TheNextPick.Engine
@inject GameStateService GameState

<div class="modal-backdrop-arcade d-flex align-items-center justify-content-center p-3" @onclick="CerrarModal">
    <div class="sports-card p-3 p-md-4 rounded-4 shadow-lg text-center" 
         style="max-width: 760px; width: 100%; max-height: 90vh; overflow-y: auto; background: #080c14; border: 3px solid #FFC72C; box-shadow: 0 0 45px rgba(255,199,44,0.35);" 
         @onclick:stopPropagation="true">
        
        <!-- ENCABEZADO DE LA SALA DE TROFEOS -->
        <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom border-dark">
            <div class="text-start">
                <span class="badge bg-warning text-dark fw-bold px-2 py-1 small">PALMARÉS & DISTINCIONES</span>
                <h2 class="nba-title text-white mb-0 fs-3">VITRINA DE TROFEOS</h2>
            </div>
            <button class="btn btn-sm btn-outline-danger fw-bold fs-5 px-3 py-0" @onclick="CerrarModal">✕</button>
        </div>

        <!-- RESUMEN HISTÓRICO RÁPIDO -->
        <div class="row g-2 mb-3 text-center small">
            <div class="col-3 p-2 rounded bg-black border border-warning">
                <span class="text-secondary d-block">ANILLOS</span>
                <strong class="text-warning fs-5">💍 @GameState.AnillosCampeon</strong>
            </div>
            <div class="col-3 p-2 rounded bg-black border border-warning">
                <span class="text-secondary d-block">MVP</span>
                <strong class="text-warning fs-5">👑 @GameState.PremiosMVP</strong>
            </div>
            <div class="col-3 p-2 rounded bg-black border border-info">
                <span class="text-secondary d-block">TOTAL PREMIOS</span>
                <strong class="text-info fs-5">🏆 @GameState.HistorialPremios.Count</strong>
            </div>
            <div class="col-3 p-2 rounded bg-black border border-success">
                <span class="text-secondary d-block">AÑOS PRO</span>
                <strong class="text-success fs-5">🏀 @GameState.TemporadaActual</strong>
            </div>
        </div>

        <!-- FILTROS POR CATEGORÍA CON ANIMACIÓN -->
        <div class="d-flex flex-wrap gap-2 justify-content-center mb-3">
            <button class="btn btn-sm @(filtroActual == null ? "btn-warning text-dark fw-bold" : "btn-dark text-secondary") arcade-btn-3d" 
                    @onclick="() => filtroActual = null">
                TODOS (@GameState.HistorialPremios.Count)
            </button>
            <button class="btn btn-sm @(filtroActual == CategoriaPremio.TrofeoMayor ? "btn-warning text-dark fw-bold" : "btn-dark text-secondary") arcade-btn-3d" 
                    @onclick="() => filtroActual = CategoriaPremio.TrofeoMayor">
                👑 MAYORES (MVP/ROY/DPOY)
            </button>
            <button class="btn btn-sm @(filtroActual == CategoriaPremio.QuintetoIdeal ? "btn-warning text-dark fw-bold" : "btn-dark text-secondary") arcade-btn-3d" 
                    @onclick="() => filtroActual = CategoriaPremio.QuintetoIdeal">
                ⭐ ALL-NBA & DEFENSIVE
            </button>
            <button class="btn btn-sm @(filtroActual == CategoriaPremio.AllStar ? "btn-warning text-dark fw-bold" : "btn-dark text-secondary") arcade-btn-3d" 
                    @onclick="() => filtroActual = CategoriaPremio.AllStar">
                🎯 ALL-STAR & EVENTOS
            </button>
            <button class="btn btn-sm @(filtroActual == CategoriaPremio.Campeonato ? "btn-warning text-dark fw-bold" : "btn-dark text-secondary") arcade-btn-3d" 
                    @onclick="() => filtroActual = CategoriaPremio.Campeonato">
                💍 CAMPEONATOS
            </button>
        </div>

        <!-- CUADRÍCULA ESTILO ESTANTERÍA DE CRISTAL ILUMINADA -->
        <div class="trophy-shelf p-3 rounded-3" style="background: radial-gradient(circle at 50% 20%, #172133 0%, #06090e 90%); border: 2px solid #1e293b; min-height: 260px;">
            @{
                var listaFiltrada = filtroActual == null 
                    ? GameState.HistorialPremios 
                    : GameState.HistorialPremios.Where(p => p.Categoria == filtroActual).ToList();
            }

            @if (listaFiltrada.Count == 0)
            {
                <div class="py-5 text-center text-muted">
                    <span class="fs-1 d-block mb-2">🏆</span>
                    <h5 class="text-white">Estantería Vacía</h5>
                    <p class="small text-secondary mb-0">Aún no has acumulado galardones en esta sección. Tu legado continúa forjándose en la temporada actual.</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var premio in listaFiltrada)
                    {
                        <div class="col-12 col-md-6 text-start">
                            <div class="p-3 rounded h-100 d-flex gap-3 align-items-center trophy-card" 
                                 style="background: #0f1624; border: 2px solid @premio.ColorBorde; box-shadow: 0 4px 15px rgba(0,0,0,0.6);">
                                
                                <!-- ICONO GIGANTE CON LUZ NEÓN -->
                                <div class="trophy-badge d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                                     style="width: 55px; height: 55px; background: #000; border: 2px solid @premio.ColorBorde;">
                                    <span style="font-size: 26px;">@premio.Icono</span>
                                </div>

                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-black text-warning font-monospace border border-secondary" style="font-size: 0.65rem;">
                                            @premio.TemporadaTexto
                                        </span>
                                        <span class="badge bg-dark text-info" style="font-size: 0.65rem;">
                                            @premio.Categoria
                                        </span>
                                    </div>
                                    <h6 class="text-white fw-bold mb-1" style="font-size: 0.95rem;">@premio.Nombre</h6>
                                    <p class="text-secondary small mb-0" style="font-size: 0.75rem; line-height: 1.3;">
                                        @premio.Descripcion
                                    </p>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- BOTÓN CERRAR -->
        <button class="btn arcade-btn-3d btn-warning w-100 py-3 fw-bold text-dark fs-5 mt-3" @onclick="CerrarModal">
            VOLVER AL JUEGO 🏀
        </button>

    </div>
</div>

<style>
    .modal-backdrop-arcade {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(5px);
        z-index: 9999;
    }
    .trophy-card {
        transition: transform 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }
    .trophy-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(255, 199, 44, 0.25) !important;
    }
    .trophy-badge {
        box-shadow: 0 0 12px rgba(255, 199, 44, 0.3);
    }
</style>

@code {
    [Parameter] public EventCallback OnCerrar { get; set; }

    private CategoriaPremio? filtroActual = null;

    private async Task CerrarModal()
    {
        await OnCerrar.InvokeAsync();
    }
}
