@namespace TheNextPick.Components
@implements IDisposable

<div class="sports-card p-3 my-3 text-center" style="max-width: 580px; margin: auto; background: #0c1017; border: 2px solid #2d3748;">
    <div class="d-flex justify-content-between align-items-center mb-2 px-2">
        <span class="badge bg-primary text-uppercase px-2 py-1 small fw-bold">PRUEBA 3/5: LANE AGILITY (CONOS)</span>
        <span class="text-white small fw-bold">CONOS: @conosTocados / 8 | TIEMPO: @((int)tiempoRestante)s</span>
    </div>

    <!-- PISTA CON 4 CONOS -->
    <div class="position-relative mx-auto rounded overflow-hidden" style="width: 100%; height: 240px; border: 2px solid #1f2937;">
        <CanchaFondo />

        <!-- 4 Conos interactivos -->
        <button class="btn p-0 position-absolute cono-btn @(conoObjetivo == 0 ? "cono-activo" : "")" 
                style="left: 60px; top: 40px;" @onclick="() => TocarCono(0)">
            🔶 <span class="badge bg-dark border border-warning text-warning d-block">CONO 1</span>
        </button>
        <button class="btn p-0 position-absolute cono-btn @(conoObjetivo == 1 ? "cono-activo" : "")" 
                style="right: 60px; top: 40px;" @onclick="() => TocarCono(1)">
            🔶 <span class="badge bg-dark border border-warning text-warning d-block">CONO 2</span>
        </button>
        <button class="btn p-0 position-absolute cono-btn @(conoObjetivo == 2 ? "cono-activo" : "")" 
                style="right: 60px; bottom: 30px;" @onclick="() => TocarCono(2)">
            🔶 <span class="badge bg-dark border border-warning text-warning d-block">CONO 3</span>
        </button>
        <button class="btn p-0 position-absolute cono-btn @(conoObjetivo == 3 ? "cono-activo" : "")" 
                style="left: 60px; bottom: 30px;" @onclick="() => TocarCono(3)">
            🔶 <span class="badge bg-dark border border-warning text-warning d-block">CONO 4</span>
        </button>

        <!-- Atleta desplazándose -->
        <div class="position-absolute start-50 top-50 translate-middle" style="z-index: 6;">
            <PixelArtPlayer Estado="Defendiendo" TieneBalon="false" ColorPrimario="#1D428A" AnchoPx="80" AltoPx="100" />
        </div>
    </div>

    @if (!activo && !finalizado)
    {
        <button class="btn btn-warning py-3 px-5 fw-bold text-dark fs-5 mt-3 w-100" @onclick="IniciarCircuito">
            INICIAR CIRCUITO DE AGILIDAD ⏱️
        </button>
    }
    else if (activo)
    {
        <div class="mt-3 text-warning fw-bold fs-5">¡TOCA EL CONO ILUMINADO! ➔ CONO @(conoObjetivo + 1)</div>
    }

    <div class="mt-2 text-info fw-semibold small">@mensajeGuia</div>
</div>

<style>
    .cono-btn { font-size: 32px; transition: transform 0.1s; }
    .cono-activo { transform: scale(1.25); filter: drop-shadow(0 0 10px #f59e0b); }
</style>

@code {
    [Parameter] public EventCallback<int> OnFinalizado { get; set; }

    private int conosTocados = 0;
    private int conoObjetivo = 0;
    private bool activo = false;
    private bool finalizado = false;
    private double tiempoRestante = 14.0;
    private int fallos = 0;
    private string mensajeGuia = "Sigue la secuencia de conos iluminados antes de que expire el tiempo.";
    private CancellationTokenSource cts = new();

    private async Task IniciarCircuito()
    {
        activo = true;
        conosTocados = 0;
        conoObjetivo = 0;
        fallos = 0;

        _ = Task.Run(async () =>
        {
            while (activo && tiempoRestante > 0 && !cts.Token.IsCancellationRequested)
            {
                tiempoRestante -= 0.1;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(100, cts.Token);
            }

            if (tiempoRestante <= 0 && activo)
            {
                await InvokeAsync(TerminarCircuitoPorTiempo);
            }
        });
    }

    private void TocarCono(int indice)
    {
        if (!activo || finalizado) return;

        if (indice == conoObjetivo)
        {
            conosTocados++;
            if (conosTocados >= 8)
            {
                TerminarExito();
                return;
            }
            // Siguiente cono aleatorio que no sea el mismo
            int nuevo;
            do { nuevo = Random.Shared.Next(0, 4); } while (nuevo == conoObjetivo);
            conoObjetivo = nuevo;
        }
        else
        {
            fallos++;
            tiempoRestante = Math.Max(0, tiempoRestante - 1.5); // Penalización de tiempo por error
        }
        StateHasChanged();
    }

    private async void TerminarExito()
    {
        finalizado = true;
        activo = false;
        cts.Cancel();

        int puntos = 20 - (fallos * 3);
        if (tiempoRestante > 6.0) puntos += 2;
        puntos = Math.Clamp(puntos, 3, 20);

        mensajeGuia = $"¡Circuito completado con {fallos} errores! (+{puntos} PTS).";
        StateHasChanged();

        await Task.Delay(1300);
        await OnFinalizado.InvokeAsync(puntos);
    }

    private async Task TerminarCircuitoPorTiempo()
    {
        finalizado = true;
        activo = false;
        cts.Cancel();

        int puntos = Math.Clamp(conosTocados * 2 - fallos, 0, 10);
        mensajeGuia = $"¡Tiempo agotado! Solo tocaste {conosTocados} conos (+{puntos} PTS).";
        StateHasChanged();

        await Task.Delay(1300);
        await OnFinalizado.InvokeAsync(puntos);
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}
