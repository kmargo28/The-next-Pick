@namespace TheNextPick.Components
@using TheNextPick.Models
@implements IDisposable

<div class="sports-card p-3 my-3 text-center" style="max-width: 620px; margin: auto; background: #0c1017; border: 2px solid #2d3748;">
    <div class="d-flex justify-content-between align-items-center mb-2 px-2">
        <span class="badge bg-success text-dark text-uppercase px-2 py-1 small fw-bold">PRUEBA 5/5: TIRO SPOT-UP COMBINE</span>
        <span class="text-white small fw-bold">CANASTAS: @canastas / 5 (@(canastas * 4) / 20 PTS)</span>
    </div>

    <div class="position-relative mx-auto rounded overflow-hidden" style="width: 100%; height: 260px; border: 2px solid #1f2937;">
        <CanchaFondo />

        <svg viewBox="0 0 140 180" class="position-absolute end-0" style="width: 120px; height: 160px; top: 35px; pointer-events: none; z-index: 5;">
            <line x1="110" y1="10" x2="110" y2="160" stroke="#000" stroke-width="8" />
            <line x1="110" y1="10" x2="110" y2="160" stroke="#cbd5e1" stroke-width="4" />
            <rect x="95" y="15" width="8" height="60" fill="#fff" stroke="#000" stroke-width="2" />
            <rect x="97" y="32" width="4" height="26" fill="none" stroke="#e11d48" stroke-width="2" />
            <line x1="58" y1="52" x2="95" y2="52" stroke="#ff4500" stroke-width="5" stroke-linecap="round" />
            <ellipse cx="76" cy="52" rx="16" ry="3.5" fill="none" stroke="#000" stroke-width="3" />
            <ellipse cx="76" cy="52" rx="15" ry="3" fill="none" stroke="#ff4500" stroke-width="2" />
        </svg>

        @if (balonVolando)
        {
            <div class="position-absolute" style="left: @(balonX)px; top: @(balonY)px; transform: translate(-50%, -50%); pointer-events: none; z-index: 15;">
                <svg width="24" height="24" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" fill="#e65100" stroke="#000" stroke-width="2" />
                    <line x1="2" y1="12" x2="22" y2="12" stroke="#000" stroke-width="1.5" />
                    <line x1="12" y1="2" x2="12" y2="22" stroke="#000" stroke-width="1.5" />
                </svg>
            </div>
        }

        <div class="position-absolute" style="left: 80px; bottom: 20px; z-index: 6;">
            <PixelArtPlayer Estado="@estadoTirador" TieneBalon="@(!balonVolando)" ColorPrimario="#1D428A" AnchoPx="95" AltoPx="115" />
        </div>
    </div>

    <div class="position-relative my-3 rounded border border-secondary" style="height: 36px; background: #000; overflow: hidden;">
        <div class="position-absolute bg-success opacity-75 h-100" style="left: @zonaVerdeInicio%; width: 12%;"></div>
        <div class="position-absolute bg-warning h-100" style="left: @posicionBarra%; width: 6px; box-shadow: 0 0 10px #f59e0b;"></div>
    </div>

    @if (!activo && !finalizado)
    {
        <button class="btn btn-warning py-3 px-5 fw-bold text-dark fs-5 mt-1 w-100" @onclick="IniciarRonda">
            COMENZAR SERIE DE TIROS (5 POSICIONES) 🏀
        </button>
    }
    else if (activo && !balonVolando)
    {
        <button class="btn btn-danger py-3 px-5 fw-bold fs-5 mt-1 text-white w-100" @onclick="Lanzar">
            ¡LANZAR! (TIRO @(tiroActual + 1)/5) 🎯
        </button>
    }
    else
    {
        <button class="btn btn-secondary py-3 px-5 fw-bold fs-5 mt-1 w-100" disabled>
            BALÓN EN EL AIRE...
        </button>
    }

    <div class="mt-2 text-info fw-semibold small">@mensajeFeedback</div>
</div>

@code {
    [Parameter] public EventCallback<int> OnFinalizado { get; set; }

    private int tiroActual = 0;
    private int canastas = 0;
    private bool activo = false;
    private bool finalizado = false;
    private bool balonVolando = false;
    private string estadoTirador = "Bote";

    private double balonX = 110;
    private double balonY = 170;

    private int posicionBarra = 0;
    private bool subiendo = true;
    private int zonaVerdeInicio = 65;
    private string mensajeFeedback = "Acierta en la zona verde desde las 5 posiciones oficiales del Combine.";
    private CancellationTokenSource cts = new();

    private void IniciarRonda()
    {
        activo = true;
        tiroActual = 0;
        canastas = 0;

        _ = Task.Run(async () =>
        {
            try
            {
                while (activo && !cts.Token.IsCancellationRequested)
                {
                    posicionBarra += subiendo ? 5 : -5;
                    if (posicionBarra >= 95) subiendo = false;
                    if (posicionBarra <= 5) subiendo = true;
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(18, cts.Token);
                }
            }
            catch (OperationCanceledException) { }
            catch (Exception) { }
        });
    }

    private async Task Lanzar()
    {
        if (balonVolando) return;
        estadoTirador = "Saltando";

        bool acierto = posicionBarra >= zonaVerdeInicio && posicionBarra <= (zonaVerdeInicio + 12);
        if (acierto) canastas++;

        balonVolando = true;
        balonX = 115;
        balonY = 160;
        StateHasChanged();

        double destinoX = acierto ? 520 : 475;
        double destinoY = 95;

        for (int i = 0; i <= 20; i++)
        {
            double t = i / 20.0;
            double alturaArco = 150;
            balonX = (1 - t) * (1 - t) * 115 + 2 * (1 - t) * t * 315 + t * t * destinoX;
            balonY = (1 - t) * (1 - t) * 160 + 2 * (1 - t) * t * (160 - alturaArco) + t * t * destinoY;
            StateHasChanged();
            await Task.Delay(16);
        }

        await Task.Delay(250);
        balonVolando = false;
        tiroActual++;
        zonaVerdeInicio = Random.Shared.Next(30, 75);

        if (tiroActual >= 5)
        {
            activo = false;
            finalizado = true;
            try { cts.Cancel(); } catch { }
            int puntosFinales = canastas * 4;
            mensajeFeedback = $"Serie completada: {canastas}/5 canastas (+{puntosFinales} PTS).";
            StateHasChanged();

            await Task.Delay(800);
            await OnFinalizado.InvokeAsync(puntosFinales);
        }
        else
        {
            estadoTirador = "Bote";
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        activo = false;
        try { cts.Cancel(); } catch { }
        try { cts.Dispose(); } catch { }
    }
}
