@namespace TheNextPick.Components

<div class="sports-card p-4 my-3 text-center border border-warning" style="max-width: 460px; margin: auto; background: linear-gradient(180deg, #181d26 0%, #0d1117 100%);">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="display-6 fw-bold text-danger nba-title">SLAM</span>
        <span class="badge bg-dark border border-secondary text-secondary small">EDICION ESPECIAL</span>
    </div>

    <div class="rounded overflow-hidden my-3 border border-secondary position-relative" style="height: 260px;">
        <img src="@ImagenFondo" style="width: 100%; height: 100%; object-fit: cover;" alt="Cover" />
        <div class="position-absolute bottom-0 start-0 w-100 p-3 text-start" style="background: linear-gradient(0deg, rgba(0,0,0,0.9) 0%, transparent 100%);">
            <h2 class="text-white fw-bold nba-title fs-1 mb-0">@Titular</h2>
            <p class="text-warning small mb-0 fw-bold">@Subtitulo</p>
        </div>
    </div>

    <button class="btn btn-warning py-2 px-4 fw-bold text-dark mt-2" @onclick="Continuar">
        Continuar Carrera
    </button>
</div>

@code {
    [Parameter] public string Titular { get; set; } = "EL NUEVO REY DE LA LIGA";
    [Parameter] public string Subtitulo { get; set; } = "Consagracion historica en la NBA";
    [Parameter] public string ImagenFondo { get; set; } = "https://images.unsplash.com/photo-1546519638-68e109498ffc?w=700&auto=format&fit=crop&q=80";
    [Parameter] public EventCallback OnCerrar { get; set; }

    private async Task Continuar() => await OnCerrar.InvokeAsync();
}
